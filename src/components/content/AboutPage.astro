---
import { Image } from 'astro:assets';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import Button from '~/components/ui/Button.astro';
import { useTranslations } from '~/i18n/utils';
import { getQuoteUrl, type Lang } from '~/utils/catalog';
import {
	aboutCatalog,
	aboutCommitments,
	aboutCopy as copy,
	aboutPills,
	aboutPublics,
	aboutTechniques,
} from '~/data/about-copy';
import heroImage from '~/assets/images/personnalisation/equipe-chantier.jpg';
import equipeBureau from '~/assets/images/personnalisation/equipe-bureau.jpg';
import equipeGroupe from '~/assets/images/personnalisation/equipe-chantier-groupe.jpg';
import vesteHvDos from '~/assets/images/personnalisation/veste-hv-dos.jpg';
import couvreChefs from '~/assets/images/personnalisation/couvre-chefs.jpg';
import poloBroderie from '~/assets/images/personnalisation/polo-broderie.jpg';
import broderieImage from '~/assets/images/personnalisation/broderie.jpg';
import serigraphieImage from '~/assets/images/personnalisation/serigraphie.jpg';
import transfertImage from '~/assets/images/personnalisation/transfert.jpg';
import emplacementsImage from '~/assets/images/a-propos/emplacements-marquage.jpg';
import bordeauxImage from '~/assets/images/a-propos/bordeaux-place-de-la-bourse.jpg';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/en' : '/';
const collectivitesHref = lang === 'en' ? '/en/collectivites' : '/collectivites';
const customisationHref = lang === 'en' ? '/en/customisation' : '/personnalisation';
const quoteHref = getQuoteUrl(lang);

// Même ordre que aboutCatalog / aboutTechniques dans about-copy.ts.
const catalogImages = [vesteHvDos, couvreChefs, poloBroderie];
const techniqueImages = [broderieImage, serigraphieImage, transfertImage, emplacementsImage];

const container = 'mx-auto max-w-6xl px-4';
const tagClass = 'mb-2 font-heading text-xs font-bold uppercase tracking-[0.12em] text-brand';
const h2Class = 'font-heading text-2xl font-bold uppercase leading-tight text-gray-900 sm:text-3xl';
const leadClass = 'max-w-3xl text-base text-gray-600 sm:text-lg';
const cardClass = 'overflow-hidden rounded-lg border border-gray-200 bg-white';
const cardTitleClass = 'mb-1 font-heading text-base font-bold text-gray-900';
const cardBodyClass = 'text-sm text-gray-600';
const linkClass = 'font-medium text-brand hover:text-brand-dark';
const checkIcon =
	'M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z';
---

<main>
	<div class={`${container} pt-6`}>
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: homeHref }, { label: t('footer.legal.about') }]} />
	</div>

	{/* Hero : photo plein écran + voile dégradé (plus sombre à gauche, sous le texte). */}
	<section class="relative isolate flex min-h-[480px] items-end bg-gray-900 text-white md:min-h-[560px]">
		<Image
			src={heroImage}
			alt={copy.heroImageAlt[lang]}
			widths={[640, 1168]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
			class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
		/>
		<div
			class="absolute inset-0 -z-10 bg-linear-to-r from-gray-950/90 via-gray-950/40 via-60% to-gray-950/20"
			aria-hidden="true"
		>
		</div>
		<div class={`${container} relative w-full pb-14 pt-20`}>
			<p class="mb-3 font-heading text-xs font-bold uppercase tracking-[0.16em]">{copy.heroKicker[lang]}</p>
			<h1 class="max-w-3xl font-heading text-3xl font-bold uppercase leading-tight sm:text-4xl lg:text-5xl">
				{copy.heroTitle[lang]}
			</h1>
			<p class="mt-4 max-w-2xl text-base text-gray-100 sm:text-lg">{copy.heroLead[lang]}</p>
			<ul class="mt-6 flex flex-wrap gap-2">
				{
					aboutPills[lang].map((pill) => (
						<li class="rounded-full border border-white/20 bg-white/10 px-3 py-1.5 text-xs sm:text-sm">{pill}</li>
					))
				}
			</ul>
		</div>
	</section>

	{/* Publics */}
	<section class="py-14 md:py-20">
		<div class={container}>
			<p class={tagClass}>{copy.publicsTag[lang]}</p>
			<h2 class={h2Class}>{copy.publicsTitle[lang]}</h2>
			<p class={`${leadClass} mt-3`}>
				{copy.publicsLead[lang]}{' '}
				<a href={collectivitesHref} class={linkClass}>{copy.publicsLink[lang]}</a>.
			</p>
			<ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
				{
					aboutPublics[lang].map((item) => (
						<li class="rounded-lg border border-gray-200 bg-white p-5">
							<h3 class={cardTitleClass}>{item.title}</h3>
							<p class={cardBodyClass}>{item.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{/* Le groupe */}
	<section class="pb-14 md:pb-20">
		<div class={`${container} grid items-center gap-8 lg:grid-cols-2`}>
			<div>
				<p class={tagClass}>{copy.groupTag[lang]}</p>
				<h2 class={h2Class}>{copy.groupTitle[lang]}</h2>
				<p class={`${leadClass} mt-3`}>{copy.groupBody1[lang]}</p>
				<p class={`${leadClass} mt-3`}>{copy.groupBody2[lang]}</p>
			</div>
			<Image
				src={equipeBureau}
				alt={copy.groupImageAlt[lang]}
				width={1200}
				height={800}
				class="h-full min-h-[300px] w-full rounded-lg object-cover"
			/>
		</div>
	</section>

	{/* Catalogue */}
	<section class="bg-gray-100 py-14 md:py-20">
		<div class={container}>
			<p class={tagClass}>{copy.catalogTag[lang]}</p>
			<h2 class={h2Class}>{copy.catalogTitle[lang]}</h2>
			<ul class="mt-6 grid gap-4 sm:grid-cols-3">
				{
					aboutCatalog[lang].map((item, index) => (
						<li>
							<article class={cardClass}>
								{/* La photo de dos (portrait) est cadrée sur le haut du dos, où est le logo. */}
								<Image
									src={catalogImages[index]}
									alt={item.alt}
									width={800}
									height={600}
									class:list={['h-48 w-full object-cover', index === 0 ? 'object-[center_28%]' : 'object-center']}
								/>
								<div class="p-4">
									<h3 class={cardTitleClass}>{item.title}</h3>
									<p class={cardBodyClass}>{item.body}</p>
								</div>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{/* Personnalisation */}
	<section class="py-14 md:py-20">
		<div class={container}>
			<p class={tagClass}>{copy.customisationTag[lang]}</p>
			<h2 class={h2Class}>{copy.customisationTitle[lang]}</h2>
			<p class={`${leadClass} mt-3`}>
				{copy.customisationLead[lang]}{' '}
				<a href={customisationHref} class={linkClass}>{copy.customisationLink[lang]}</a>.
			</p>
			<ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
				{
					aboutTechniques[lang].map((item, index) => (
						<li>
							<article class={cardClass}>
								{/* Le visuel « emplacements » ne fait que 608 px de large : pas d'agrandissement. */}
								<Image
									src={techniqueImages[index]}
									alt={item.alt}
									width={index === 3 ? 608 : 800}
									height={index === 3 ? 426 : 600}
									class="aspect-[4/3] w-full object-cover object-center"
								/>
								<div class="p-4">
									<h3 class={cardTitleClass}>{item.title}</h3>
									<p class={cardBodyClass}>{item.body}</p>
								</div>
							</article>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	{/* Méthode : texte d'abord dans le DOM (lecture mobile), photo à gauche sur desktop. */}
	<section class="bg-gray-100 py-14 md:py-20">
		<div class={`${container} grid items-center gap-8 lg:grid-cols-2`}>
			<div>
				<p class={tagClass}>{copy.methodTag[lang]}</p>
				<h2 class={h2Class}>{copy.methodTitle[lang]}</h2>
				<p class={`${leadClass} mt-3`}>{copy.methodBody1[lang]}</p>
				<p class={`${leadClass} mt-3`}>{copy.methodBody2[lang]}</p>
			</div>
			<Image
				src={equipeGroupe}
				alt={copy.methodImageAlt[lang]}
				width={1200}
				height={800}
				class="h-full min-h-[300px] w-full rounded-lg object-cover lg:order-first"
			/>
		</div>
	</section>

	{/* Engagements */}
	<section class="bg-gray-950 py-14 text-white md:py-20">
		<div class={`${container} grid items-center gap-8 lg:grid-cols-2`}>
			<div>
				<p class="mb-2 font-heading text-xs font-bold uppercase tracking-[0.12em] text-blue-300">
					{copy.commitmentsTag[lang]}
				</p>
				<h2 class="font-heading text-2xl font-bold uppercase leading-tight sm:text-3xl">{copy.commitmentsTitle[lang]}</h2>
				<ul class="mt-5 space-y-3 text-base text-gray-300">
					{
						aboutCommitments[lang].map((item) => (
							<li class="flex gap-3">
								<svg class="mt-1 h-4 w-4 shrink-0 text-blue-300" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d={checkIcon} clip-rule="evenodd" />
								</svg>
								{item}
							</li>
						))
					}
				</ul>
			</div>
			<div class="relative min-h-[280px] overflow-hidden rounded-lg">
				<Image
					src={bordeauxImage}
					alt={copy.cityImageAlt[lang]}
					width={1200}
					height={675}
					class="absolute inset-0 h-full w-full object-cover"
				/>
				<span class="absolute bottom-4 left-4 rounded-lg bg-brand px-4 py-3 font-heading text-sm font-bold uppercase text-white">
					{copy.cityLabel[lang]}
				</span>
			</div>
		</div>
	</section>

	{/* CTA */}
	<section class="bg-brand py-14 text-center text-white" data-pagefind-ignore>
		<div class={container}>
			<h2 class="font-heading text-2xl font-bold uppercase leading-tight sm:text-3xl">{copy.ctaTitle[lang]}</h2>
			<p class="mt-3 text-base text-white/90">{copy.ctaBody[lang]}</p>
			<a href={copy.phoneHref[lang]} class="mt-4 block font-heading text-3xl font-bold tracking-tight hover:underline">
				{copy.phoneLabel[lang]}
			</a>
			<Button href={quoteHref} variant="white" class="mt-6">{copy.ctaButton[lang]}</Button>
		</div>
	</section>
</main>
