---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Tile {
	href: string;
	label: string;
	image?: ImageMetadata | string;
	imagePositionClass?: string;
}

interface Props {
	tiles: Tile[];
}

const { tiles } = Astro.props;

const imageClass = (tile: Tile) =>
	`h-full w-full object-cover transition-transform group-hover:scale-105 ${tile.imagePositionClass ?? 'object-center'}`;
---

<ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
	{
		tiles.map((tile) => {
			if (typeof tile.image === 'string') {
				const src = tile.image;
				return (
					<li>
						<a
							href={tile.href}
							class="group relative block h-40 overflow-hidden rounded-lg border border-gray-200 transition-colors hover:border-gray-400"
						>
							<img
								src={src}
								alt=""
								width="400"
								height="300"
								loading="lazy"
								decoding="async"
								class={imageClass(tile)}
								onerror="this.onerror=null;this.src='/images/product-placeholder.svg';"
							/>
							<div class="absolute inset-0 bg-gray-900/40" />
							<span class="absolute inset-x-0 bottom-0 p-3 font-medium text-white">{tile.label}</span>
						</a>
					</li>
				);
			}

			if (tile.image) {
				const src = tile.image;
				return (
					<li>
						<a
							href={tile.href}
							class="group relative block h-40 overflow-hidden rounded-lg border border-gray-200 transition-colors hover:border-gray-400"
						>
							<Image src={src} alt="" width={400} height={300} class={imageClass(tile)} />
							<div class="absolute inset-0 bg-gray-900/40" />
							<span class="absolute inset-x-0 bottom-0 p-3 font-medium text-white">{tile.label}</span>
						</a>
					</li>
				);
			}

			return (
				<li>
					<a
						href={tile.href}
						class="block rounded-lg border border-gray-200 p-6 text-center font-medium text-gray-900 transition-colors hover:border-gray-400 hover:bg-gray-50"
					>
						{tile.label}
					</a>
				</li>
			);
		})
	}
</ul>
