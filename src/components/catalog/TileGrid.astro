---
interface Tile {
	href: string;
	label: string;
}

interface Props {
	tiles: Tile[];
}

const { tiles } = Astro.props;
---

<ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
	{
		tiles.map((tile) => (
			<li>
				<a
					href={tile.href}
					class="block rounded-lg border border-gray-200 p-6 text-center font-medium text-gray-900 transition-colors hover:border-gray-400 hover:bg-gray-50"
				>
					{tile.label}
				</a>
			</li>
		))
	}
</ul>
