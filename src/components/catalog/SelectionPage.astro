---
import { useTranslations } from '~/i18n/utils';
import type { Product } from '~/content/schemas/product';
import { getCatalogRootUrl, type Lang } from '~/utils/catalog';
import Breadcrumb from './Breadcrumb.astro';
import ProductGrid from './ProductGrid.astro';
import CatalogSidebar from './CatalogSidebar.astro';

interface Props {
	lang: Lang;
	title: string;
	intro?: string;
	products: Product[];
	payloadUrl?: string;
}

const { lang, title, intro, products, payloadUrl } = Astro.props;
const t = useTranslations(lang);

const homeHref = lang === 'en' ? '/en' : '/';
---

<Breadcrumb
	items={[
		{ label: t('catalog.breadcrumb.home'), href: homeHref },
		{ label: t('catalog.breadcrumb.products'), href: getCatalogRootUrl(lang) },
		{ label: title },
	]}
/>
<h1 class="mb-2 font-heading text-3xl font-bold uppercase text-gray-900">{title}</h1>
{intro && <p class="mb-6 max-w-3xl text-gray-600">{intro}</p>}
<ProductGrid lang={lang} products={products} payloadUrl={payloadUrl}>
	<CatalogSidebar
		slot="sidebar"
		lang={lang}
		suppliers={[...new Set(products.map((product) => product.supplier))].sort()}
	/>
</ProductGrid>
