---
import type { Product } from '../../content/schemas/product';
import type { Lang } from '../../utils/catalog';
import { getProductUrl } from '../../utils/catalog';
import { formatPrice } from '../../utils/format';

interface Props {
	lang: Lang;
	product: Product;
}

const { lang, product } = Astro.props;
const href = getProductUrl(lang, product.category, product.subcategory, product.slug);
---

<a
	href={href}
	class="group block overflow-hidden rounded-lg border border-gray-200 transition-colors hover:border-gray-400"
>
	<div class="aspect-square overflow-hidden bg-gray-50">
		<img
			src={product.imageUrl}
			width="1100"
			height="1100"
			alt={product.name}
			loading="lazy"
			decoding="async"
			class="h-full w-full object-contain transition-transform group-hover:scale-105"
			onerror="this.onerror=null;this.src='/images/product-placeholder.svg';"
		/>
	</div>
	<div class="p-3">
		<p class="truncate text-sm font-medium text-gray-900">{product.name}</p>
		<p class="text-xs text-gray-500">{product.colour}</p>
		<p class="mt-1 text-sm font-semibold text-gray-900">{formatPrice(product.price, lang)}</p>
	</div>
</a>
