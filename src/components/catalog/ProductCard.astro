---
import type { Product } from '../../content/schemas/product';
import type { Lang } from '../../utils/catalog';
import { getProductUrl } from '../../utils/catalog';
import { useTranslations } from '../../i18n/utils';
import { formatPriceRange } from '../../utils/format';
import { formatSizeRange } from '../../utils/sizes';
import { colourToCss } from '../../utils/colours';
import { MAX_SWATCHES } from '../../utils/listing-payload';

interface Props {
	lang: Lang;
	product: Product;
	title?: string;
	colourways?: Product[];
	priceRange?: { min: number; max: number };
	sizes?: string[];
}

const { lang, product, title, colourways, priceRange, sizes } = Astro.props;
const t = useTranslations(lang);
const href = getProductUrl(lang, product.category, product.subcategory, product.slug);
const price = priceRange ?? {
	min: product.price > 0 ? product.price : 0,
	max: product.price > 0 ? product.price : 0,
};
const priceLabel = price.max > 0 ? formatPriceRange(price.min, price.max, lang) : t('catalog.priceOnRequest');
const sizeRange = formatSizeRange(sizes ?? product.sizes);
const swatches = (colourways ?? []).length > 1 ? (colourways ?? []).slice(0, MAX_SWATCHES) : [];
const extraColourways = (colourways ?? []).length - swatches.length;
---

<div class="group flex h-full flex-col rounded-lg border border-gray-200 bg-white p-3 transition-colors hover:border-gray-400">
	<a
		href={href}
		class="line-clamp-2 min-h-10 font-heading text-sm font-bold uppercase leading-tight text-gray-900 hover:text-brand"
	>
		{title ?? product.name}
	</a>
	<a href={href} class="mt-2 block aspect-square overflow-hidden bg-white" tabindex="-1" aria-hidden="true">
		<img
			src={product.imageUrl}
			width="1100"
			height="1100"
			alt={title ?? product.name}
			loading="lazy"
			decoding="async"
			class="h-full w-full object-contain transition-transform group-hover:scale-105"
			onerror="this.onerror=null;this.src='/images/product-placeholder.svg';"
		/>
	</a>
	{
		swatches.length > 0 && (
			<ul class="mt-2 flex items-center gap-1.5">
				{swatches.map((colourway) => (
					<li>
						<a
							href={getProductUrl(lang, colourway.category, colourway.subcategory, colourway.slug)}
							class="block h-6 w-6 rounded-full border border-gray-300 hover:border-brand"
							title={colourway.colour}
							style={`background: ${colourToCss(colourway.colour)}`}
						>
							<span class="sr-only">{colourway.colour}</span>
						</a>
					</li>
				))}
				{extraColourways > 0 && <li class="text-xs text-gray-500">+{extraColourways}</li>}
			</ul>
		)
	}
	<div class="mt-auto pt-2">
		{sizeRange && <p class="text-xs text-gray-500">{sizeRange}</p>}
		<p class="mt-1 text-sm font-bold text-gray-900">{priceLabel}</p>
		<a
			href={href}
			class="mt-2 flex h-10 items-center justify-center rounded-card-btn border border-gray-300 font-heading text-xs font-bold uppercase text-gray-900 transition-colors hover:border-brand hover:text-brand"
		>
			{t('catalog.viewProduct')}
		</a>
	</div>
</div>
