---
import { useTranslations } from '~/i18n/utils';
import type { Category, Subcategory } from '~/data/category-taxonomy';
import type { Product } from '~/content/schemas/product';
import { getGarmentTypesBySubcategory } from '~/data/garment-types';
import { getCatalogRootUrl, getCategoryUrl, getGarmentTypeUrl, getSubcategoryUrl, type Lang } from '~/utils/catalog';
import Breadcrumb from './Breadcrumb.astro';
import TileGrid from './TileGrid.astro';
import ProductGrid from './ProductGrid.astro';
import CatalogSidebar from './CatalogSidebar.astro';

interface Props {
	lang: Lang;
	category: Category;
	subcategory: Subcategory;
	products: Product[];
}

const { lang, category, subcategory, products } = Astro.props;
const t = useTranslations(lang);

const homeHref = lang === 'en' ? '/en' : '/';

// Sous-catégories (types de vêtements) affichées uniquement ici, en haut de la
// page — pas dans le menu (cf. demande « faciliter la navigation »).
const typeTiles = getGarmentTypesBySubcategory(category.slug, subcategory.slug).map((garmentType) => ({
	href: getGarmentTypeUrl(lang, garmentType.slug),
	label: garmentType.labels[lang],
}));
---

<Breadcrumb
	items={[
		{ label: t('catalog.breadcrumb.home'), href: homeHref },
		{ label: t('catalog.breadcrumb.products'), href: getCatalogRootUrl(lang) },
		{ label: category.labels[lang], href: getCategoryUrl(lang, category.slug) },
		{ label: subcategory.labels[lang] },
	]}
/>
<h1 class="mb-6 font-heading text-3xl font-bold uppercase text-gray-900">{subcategory.labels[lang]}</h1>
{
	typeTiles.length > 0 && (
		<div class="mb-8">
			<TileGrid tiles={typeTiles} />
		</div>
	)
}
<ProductGrid
	lang={lang}
	products={products}
	payloadUrl={`${getSubcategoryUrl(lang, category.slug, subcategory.slug)}/listing.json`}
>
	<CatalogSidebar
		slot="sidebar"
		lang={lang}
		suppliers={[...new Set(products.map((product) => product.supplier))].sort()}
		currentCategory={category.slug}
		currentSubcategory={subcategory.slug}
	/>
</ProductGrid>
