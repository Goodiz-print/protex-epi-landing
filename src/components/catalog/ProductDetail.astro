---
import { useTranslations } from '../../i18n/utils';
import type { Product } from '../../content/schemas/product';
import { getQuoteUrl, type Lang } from '../../utils/catalog';
import { formatPrice } from '../../utils/format';
import SizeList from './SizeList.astro';

interface Props {
	lang: Lang;
	product: Product;
}

const { lang, product } = Astro.props;
const t = useTranslations(lang);
const quoteHref = `${getQuoteUrl(lang)}?product=${encodeURIComponent(product.name)}&sku=${encodeURIComponent(product.styleCode)}`;
---

<div class="grid gap-8 md:grid-cols-2">
	<div class="aspect-square overflow-hidden rounded-lg bg-gray-50">
		<img
			src={product.imageUrl}
			width="1100"
			height="1100"
			alt={product.name}
			loading="eager"
			decoding="async"
			class="h-full w-full object-contain"
			onerror="this.onerror=null;this.src='/images/product-placeholder.svg';"
		/>
	</div>
	<div>
		<h1 class="text-2xl font-semibold text-gray-900">{product.name}</h1>
		<p class="mt-1 text-gray-500">
			{t('catalog.colourLabel')}: {product.colour}
		</p>
		<p class="mt-4 text-xl font-semibold text-gray-900">{formatPrice(product.price, lang)}</p>
		<p class="mt-4 whitespace-pre-line text-gray-700">{product.description}</p>
		<div class="mt-6">
			<SizeList lang={lang} sizes={product.sizes} />
		</div>
		<a
			href={quoteHref}
			class="mt-6 inline-block rounded-md bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700"
		>
			{t('catalog.requestQuote')}
		</a>
	</div>
</div>
