---
import { breadcrumbJsonLd } from '~/utils/seo';

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const jsonLd = breadcrumbJsonLd(items, site, Astro.url.pathname);
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
<nav class="mb-6 flex flex-wrap items-center gap-1 text-sm text-gray-500" aria-label="Breadcrumb">
	{
		items.map((item, index) => (
			<Fragment>
				{index > 0 && <span aria-hidden="true">/</span>}
				{item.href ? (
					<a href={item.href} class="hover:text-gray-900">
						{item.label}
					</a>
				) : (
					<span class="text-gray-900">{item.label}</span>
				)}
			</Fragment>
		))
	}
</nav>
