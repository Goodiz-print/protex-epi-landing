---
interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="mb-6 flex flex-wrap items-center gap-1 text-sm text-gray-500" aria-label="Breadcrumb">
	{
		items.map((item, index) => (
			<Fragment>
				{index > 0 && <span aria-hidden="true">/</span>}
				{item.href ? (
					<a href={item.href} class="hover:text-gray-900">
						{item.label}
					</a>
				) : (
					<span class="text-gray-900">{item.label}</span>
				)}
			</Fragment>
		))
	}
</nav>
