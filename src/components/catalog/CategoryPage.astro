---
import { useTranslations } from '~/i18n/utils';
import type { Category } from '~/data/category-taxonomy';
import type { Product } from '~/content/schemas/product';
import { getCatalogRootUrl, getSubcategoryUrl, type Lang } from '~/utils/catalog';
import Breadcrumb from './Breadcrumb.astro';
import TileGrid from './TileGrid.astro';
import ProductGrid from './ProductGrid.astro';

interface Props {
	lang: Lang;
	category: Category;
	products: Product[];
}

const { lang, category, products } = Astro.props;
const t = useTranslations(lang);

const homeHref = lang === 'en' ? '/en' : '/';
const tiles = category.subcategories.map((subcategory) => ({
	href: getSubcategoryUrl(lang, category.slug, subcategory.slug),
	label: subcategory.labels[lang],
}));
---

<Breadcrumb
	items={[
		{ label: t('catalog.breadcrumb.home'), href: homeHref },
		{ label: t('catalog.breadcrumb.products'), href: getCatalogRootUrl(lang) },
		{ label: category.labels[lang] },
	]}
/>
<h1 class="mb-6 text-2xl font-semibold text-gray-900">{category.labels[lang]}</h1>
{tiles.length > 0 ? <TileGrid tiles={tiles} /> : <ProductGrid lang={lang} products={products} />}
