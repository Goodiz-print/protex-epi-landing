---
import { useTranslations } from '~/i18n/utils';
import type { Lang } from '~/utils/catalog';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const searchUrl = lang === 'en' ? '/en/search' : '/recherche';
const searchIndexUrl = lang === 'en' ? '/en/search-index.json' : '/search-index.json';
---

{/* Formulaire GET natif : Entrée mène à la page de résultats même sans JS. */}
<form
	class="relative w-full min-w-0 max-w-xl"
	action={searchUrl}
	method="get"
	role="search"
	data-searchbox
	data-no-results-label={t('search.noResults')}
	data-view-all-label={t('search.viewAll')}
	data-search-url={searchUrl}
	data-search-index-url={searchIndexUrl}
	data-pagefind-ignore
>
	<label for="site-search" class="sr-only">{t('search.label')}</label>
	<input
		id="site-search"
		name="q"
		type="search"
		autocomplete="off"
		placeholder={t('search.placeholder')}
		class="h-10 w-full rounded-full border-0 bg-field pl-4 pr-12 text-sm text-gray-700 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.06)] focus:shadow-[inset_0_0_0_1px_var(--color-brand)] focus:outline-none"
		data-search-input
	/>
	<button
		type="submit"
		class="absolute right-1 top-1 flex h-8 w-8 items-center justify-center rounded-full bg-brand text-white transition-colors hover:bg-brand-dark"
		aria-label={t('search.label')}
		data-search-button
	>
		<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
			<path
				fill-rule="evenodd"
				d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z"
				clip-rule="evenodd"></path>
		</svg>
	</button>
	<ul
		data-search-results
		class="absolute left-0 right-0 top-full z-50 mt-1 hidden max-h-96 overflow-y-auto rounded-md border border-gray-200 bg-white p-1 shadow-lg"
	>
	</ul>
</form>

<script>
	import { loadSearchEngine, type PagefindApi } from '~/utils/catalog-search';

	function debounce<T extends (...args: never[]) => void>(fn: T, delay: number) {
		let timer: ReturnType<typeof setTimeout>;
		return (...args: Parameters<T>) => {
			clearTimeout(timer);
			timer = setTimeout(() => fn(...args), delay);
		};
	}

	function initSearchBoxes() {
		document.querySelectorAll<HTMLElement>('[data-searchbox]').forEach((box) => {
			const input = box.querySelector<HTMLInputElement>('[data-search-input]');
			const results = box.querySelector<HTMLUListElement>('[data-search-results]');
			if (!input || !results) return;

			const noResultsLabel = box.dataset.noResultsLabel ?? '';
			const viewAllLabel = box.dataset.viewAllLabel ?? '';
			const searchUrl = box.dataset.searchUrl ?? '/recherche';
			const searchIndexUrl = box.dataset.searchIndexUrl ?? '/search-index.json';
			let pagefind: PagefindApi | null = null;
			let pagefindFailed = false;

			async function ensurePagefind() {
				if (pagefind || pagefindFailed) return pagefind;
				try {
					pagefind = await loadSearchEngine(searchIndexUrl);
				} catch {
					pagefindFailed = true;
				}
				return pagefind;
			}

			function hideResults() {
				results!.classList.add('hidden');
				results!.replaceChildren();
			}

			const runSearch = debounce(async (query: string) => {
				if (query.trim().length < 2) {
					hideResults();
					return;
				}
				const pf = await ensurePagefind();
				if (!pf) return;

				const search = await pf.search(query);
				const entries = await Promise.all(search.results.slice(0, 8).map((result) => result.data()));

				results!.replaceChildren();
				if (entries.length === 0) {
					const li = document.createElement('li');
					li.className = 'px-3 py-2 text-sm text-gray-500';
					li.textContent = noResultsLabel;
					results!.appendChild(li);
				} else {
					for (const entry of entries) {
						const li = document.createElement('li');
						const a = document.createElement('a');
						a.href = entry.url;
						a.className = 'block rounded-md px-3 py-2 hover:bg-gray-50';
						const title = document.createElement('p');
						title.className = 'truncate text-sm font-medium text-gray-900';
						title.textContent = entry.meta?.title ?? entry.url;
						const excerpt = document.createElement('p');
						excerpt.className = 'truncate text-xs text-gray-500';
						excerpt.innerHTML = entry.excerpt;
						a.append(title, excerpt);
						li.appendChild(a);
						results!.appendChild(li);
					}
					const viewAllItem = document.createElement('li');
					const viewAllLink = document.createElement('a');
					viewAllLink.href = `${searchUrl}?q=${encodeURIComponent(query.trim())}`;
					viewAllLink.className =
						'block rounded-md border-t border-gray-100 px-3 py-2 text-sm font-medium text-brand hover:bg-gray-50';
					viewAllLink.textContent = `${viewAllLabel} →`;
					viewAllItem.appendChild(viewAllLink);
					results!.appendChild(viewAllItem);
				}
				results!.classList.remove('hidden');
			}, 150);

			input.addEventListener('input', () => runSearch(input.value));
			input.addEventListener('focus', () => {
				if (input.value.trim().length >= 2) runSearch(input.value);
			});
			document.addEventListener('click', (event) => {
				if (!box.contains(event.target as Node)) hideResults();
			});
		});
	}

	initSearchBoxes();
</script>
