---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations } from '~/i18n/utils';
import type { Lang } from '~/utils/catalog';
import jePersonnalise from '~/assets/images/info/je-personnalise.png';
import facturationPro from '~/assets/images/info/facturation-pro.png';
import normes from '~/assets/images/info/normes.png';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface InfoTile {
	label: string;
	image: ImageMetadata;
	/** Absent pour la case Chorus Pro : simple survol, pas de clic (demande client). */
	href?: string;
	/** Le titre est déjà incrusté dans le visuel : pas de bandeau texte par-dessus. */
	labelOnImage?: boolean;
}

const tiles: InfoTile[] = [
	{
		label: t('home.info.personalise'),
		image: jePersonnalise,
		href: lang === 'en' ? '/en/customisation' : '/personnalisation',
	},
	{
		label: t('home.info.chorus'),
		image: facturationPro,
		labelOnImage: true,
	},
	{
		label: t('home.info.norms'),
		image: normes,
		href: lang === 'en' ? '/en/standards' : '/les-normes',
		labelOnImage: true,
	},
];

// Les visuels Chorus Pro et Normes sont en 2:1 : les cases adoptent ce ratio
// pour les afficher entiers, sans aucun rognage.
const cardClass = 'group relative block aspect-[2/1] overflow-hidden rounded-lg border border-gray-200';
const imageClass = 'h-full w-full object-cover transition-transform duration-300 group-hover:scale-105';
const labelClass =
	'absolute inset-x-0 bottom-0 bg-gradient-to-t from-gray-900/70 to-transparent p-4 pt-8 font-heading text-base font-bold uppercase text-white';
---

<section class="mx-auto max-w-6xl px-4 pb-14">
	<ul class="grid gap-4 sm:grid-cols-3">
		{
			tiles.map((tile) => (
				<li>
					{tile.href ? (
						<a href={tile.href} aria-label={tile.label} class={`${cardClass} transition-colors hover:border-brand`}>
							<Image src={tile.image} alt={tile.labelOnImage ? tile.label : ''} width={800} class={imageClass} />
							{!tile.labelOnImage && <span class={labelClass}>{tile.label}</span>}
						</a>
					) : (
						<div class={cardClass}>
							<Image src={tile.image} alt={tile.labelOnImage ? tile.label : ''} width={800} class={imageClass} />
							{!tile.labelOnImage && <span class={labelClass}>{tile.label}</span>}
						</div>
					)}
				</li>
			))
		}
	</ul>
</section>
