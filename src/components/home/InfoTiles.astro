---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { useTranslations } from '~/i18n/utils';
import type { Lang } from '~/utils/catalog';
import jePersonnalise from '~/assets/images/info/je-personnalise.png';
import facturationPro from '~/assets/images/info/facturation-pro.png';
import normes from '~/assets/images/info/normes.png';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

interface InfoTile {
	label: string;
	image: ImageMetadata;
	/** Absent pour la case Chorus Pro : simple survol, pas de clic (demande client). */
	href?: string;
	imageClass?: string;
}

const tiles: InfoTile[] = [
	{
		label: t('home.info.personalise'),
		image: jePersonnalise,
		href: lang === 'en' ? '/en/customisation' : '/personnalisation',
	},
	{
		label: t('home.info.chorus'),
		image: facturationPro,
		imageClass: 'object-contain bg-white p-4',
	},
	{
		label: t('home.info.norms'),
		image: normes,
		href: lang === 'en' ? '/en/standards' : '/les-normes',
	},
];

const cardClass =
	'group relative block h-44 overflow-hidden rounded-lg border border-gray-200 sm:h-52';
const imageClass = (tile: InfoTile) =>
	`h-full w-full object-cover transition-transform duration-300 group-hover:scale-105 ${tile.imageClass ?? ''}`;
const labelClass =
	'absolute inset-x-0 bottom-0 bg-gradient-to-t from-gray-900/70 to-transparent p-4 pt-8 font-heading text-base font-bold uppercase text-white';
---

<section class="mx-auto max-w-6xl px-4 pb-14">
	<ul class="grid gap-4 sm:grid-cols-3">
		{
			tiles.map((tile) => (
				<li>
					{tile.href ? (
						<a href={tile.href} class={`${cardClass} transition-colors hover:border-brand`}>
							<Image src={tile.image} alt="" width={600} height={400} class={imageClass(tile)} />
							<span class={labelClass}>{tile.label}</span>
						</a>
					) : (
						<div class={cardClass}>
							<Image src={tile.image} alt="" width={600} height={400} class={imageClass(tile)} />
							<span class={`${labelClass} from-gray-900/60`}>{tile.label}</span>
						</div>
					)}
				</li>
			))
		}
	</ul>
</section>
