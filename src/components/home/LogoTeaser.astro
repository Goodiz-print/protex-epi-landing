---
import { useTranslations } from '~/i18n/utils';
import type { Lang } from '~/utils/catalog';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="border-t border-gray-200 bg-gray-50">
	<div class="mx-auto max-w-6xl px-4 py-16 text-center">
		<h2 class="text-2xl font-semibold text-gray-900">{t('home.logoTeaser.title')}</h2>
		<p class="mx-auto mt-3 max-w-xl text-gray-600">{t('home.logoTeaser.body')}</p>
		<a
			href="mailto:contact@protex-epi.com"
			class="mt-6 inline-block rounded-md border border-gray-300 bg-white px-6 py-3 font-medium text-gray-900 transition-colors hover:border-gray-400"
		>
			{t('home.logoTeaser.cta')}
		</a>
	</div>
</section>
