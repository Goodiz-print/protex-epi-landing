---
type Variant = 'primary' | 'dark' | 'gray' | 'outline-white';

interface Props {
  variant?: Variant;
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: string]: unknown;
}

const { variant = 'primary', href, type = 'button', class: className = '', ...rest } = Astro.props;

const variantClasses: Record<Variant, string> = {
  primary: 'bg-brand text-white hover:bg-brand-dark',
  dark: 'bg-btn-dark text-white hover:bg-nav',
  gray: 'bg-btn-gray text-white hover:bg-btn-dark',
  'outline-white': 'border border-white text-white hover:bg-white/10',
};

const classes = `inline-flex h-[50px] items-center justify-center gap-2 rounded-btn px-6 text-center font-heading text-sm font-bold uppercase tracking-wide transition-colors ${variantClasses[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
