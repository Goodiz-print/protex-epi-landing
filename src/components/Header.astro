---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-protex-EPI.png';
import Nav from './Nav.astro';
import type { Lang } from '../utils/catalog';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const homeHref = lang === 'en' ? '/en' : '/';
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white">
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
		<a href={homeHref} class="flex shrink-0 items-center">
			<Image src={logo} alt="Protex EPI" width={160} height={68} class="h-10 w-auto" />
		</a>
		<Nav lang={lang} />
	</div>
</header>
