---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-protex-EPI.png';
import Nav from './Nav.astro';
import SearchBox from './SearchBox.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../utils/catalog';

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const homeHref = lang === 'en' ? '/en' : '/';
const t = useTranslations(lang);
---

<header class="sticky top-0 z-50 border-b border-gray-200 bg-white" data-pagefind-ignore>
	<div class="hidden border-b border-gray-100 bg-gray-50 sm:block">
		<div class="mx-auto flex h-9 max-w-6xl items-center justify-end gap-6 px-4 text-sm text-gray-600">
			<a href="tel:0557027587" class="flex items-center gap-1.5 hover:text-gray-900" aria-label={t('header.callUs')}>
				<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path d="M2 3.5A1.5 1.5 0 013.5 2h1.148a1.5 1.5 0 011.465 1.175l.716 3.223a1.5 1.5 0 01-.42 1.409l-.834.834a11.037 11.037 0 006.02 6.02l.834-.834a1.5 1.5 0 011.409-.42l3.223.716A1.5 1.5 0 0118 15.352V16.5a1.5 1.5 0 01-1.5 1.5H15c-7.18 0-13-5.82-13-13V3.5z" />
				</svg>
				05 57 02 75 87
			</a>
			<a
				href="mailto:contact@protex-epi.com"
				class="flex items-center gap-1.5 hover:text-gray-900"
				aria-label={t('header.emailUs')}
			>
				<svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path d="M3 4a2 2 0 00-2 2v1.161l8.441 4.221a1.25 1.25 0 001.118 0L19 7.162V6a2 2 0 00-2-2H3z" />
					<path d="M19 8.839l-7.77 3.885a2.75 2.75 0 01-2.46 0L1 8.839V14a2 2 0 002 2h14a2 2 0 002-2V8.839z" />
				</svg>
				contact@protex-epi.com
			</a>
		</div>
	</div>
	<div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
		<a href={homeHref} class="flex shrink-0 items-center">
			<Image src={logo} alt="Protex EPI" width={160} height={68} class="h-10 w-auto" />
		</a>
		<SearchBox lang={lang} />
		<Nav lang={lang} />
	</div>
</header>
