---
import { useTranslations } from '~/i18n/utils';
import type { Lang } from '~/utils/catalog';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Soumission HTML native vers la fonction Netlify (netlify/functions/quote.mts),
// qui envoie l'e-mail via Resend puis redirige vers /merci — aucun JavaScript
// requis pour envoyer. Le seul script ci-dessous pré-remplit le champ produit
// depuis ?product=&sku= (liens « Demander un devis » des fiches produit) et
// affiche la bannière d'erreur au retour de ?error=1.
---

<form method="POST" action="/.netlify/functions/quote" class="grid gap-4" data-quote-form>
	<input type="hidden" name="locale" value={lang} />

	{/* Piège à bots : masqué visuellement et retiré de l'ordre de tabulation. */}
	<p class="hidden" aria-hidden="true">
		<label>{t('quote.form.honeypot')} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
	</p>

	<div>
		<label for="quote-product" class="mb-1 block text-sm font-medium text-gray-900">
			{t('quote.form.product')}
		</label>
		<input
			id="quote-product"
			name="product"
			type="text"
			maxlength="300"
			placeholder={t('quote.form.productPlaceholder')}
			class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
		/>
	</div>

	<div class="grid gap-4 sm:grid-cols-2">
		<div>
			<label for="quote-name" class="mb-1 block text-sm font-medium text-gray-900">
				{t('quote.form.name')} *
			</label>
			<input
				id="quote-name"
				name="name"
				type="text"
				required
				maxlength="200"
				autocomplete="name"
				class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
			/>
		</div>
		<div>
			<label for="quote-company" class="mb-1 block text-sm font-medium text-gray-900">
				{t('quote.form.company')}
			</label>
			<input
				id="quote-company"
				name="company"
				type="text"
				maxlength="200"
				autocomplete="organization"
				class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
			/>
		</div>
	</div>

	<div class="grid gap-4 sm:grid-cols-2">
		<div>
			<label for="quote-email" class="mb-1 block text-sm font-medium text-gray-900">
				{t('quote.form.email')} *
			</label>
			<input
				id="quote-email"
				name="email"
				type="email"
				required
				maxlength="254"
				autocomplete="email"
				class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
			/>
		</div>
		<div>
			<label for="quote-phone" class="mb-1 block text-sm font-medium text-gray-900">
				{t('quote.form.phone')}
			</label>
			<input
				id="quote-phone"
				name="phone"
				type="tel"
				maxlength="50"
				autocomplete="tel"
				class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
			/>
		</div>
	</div>

	<div class="sm:w-48">
		<label for="quote-quantity" class="mb-1 block text-sm font-medium text-gray-900">
			{t('quote.form.quantity')}
		</label>
		<input
			id="quote-quantity"
			name="quantity"
			type="number"
			min="1"
			step="1"
			class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
		/>
	</div>

	<div>
		<label for="quote-message" class="mb-1 block text-sm font-medium text-gray-900">
			{t('quote.form.message')}
		</label>
		<textarea
			id="quote-message"
			name="message"
			rows="4"
			maxlength="5000"
			placeholder={t('quote.form.messagePlaceholder')}
			class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
		></textarea>
	</div>

	<p class="text-xs text-gray-500">{t('quote.form.requiredHint')} (*)</p>

	<div data-form-error role="alert" class="hidden rounded-md bg-red-50 p-3 text-sm text-red-700">
		{t('quote.form.error')}
	</div>

	<button
		type="submit"
		class="inline-flex w-fit items-center rounded-md bg-brand px-6 py-3 font-medium text-white transition-colors hover:bg-brand-dark"
	>
		{t('quote.form.submit')}
	</button>
</form>

<script>
	document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
		const params = new URLSearchParams(window.location.search);
		const productField = form.querySelector<HTMLInputElement>('#quote-product');
		const productName = params.get('product');
		const productSku = params.get('sku');
		if (productField && productName) {
			productField.value = productSku ? `${productName} (${productSku})` : productName;
		}
		if (params.get('error') === '1') {
			form.querySelector<HTMLElement>('[data-form-error]')?.classList.remove('hidden');
		}
	});
</script>
