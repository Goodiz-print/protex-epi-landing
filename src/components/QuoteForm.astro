---
import { useTranslations } from '~/i18n/utils';
import type { Lang } from '~/utils/catalog';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The form submits directly to a form-to-email endpoint so the visitor never
// has to open their own email client. By default it goes through FormSubmit
// (AJAX endpoint keyed on the destination address — the first submission
// triggers a one-time activation email to that address). Set
// PUBLIC_QUOTE_FORM_ENDPOINT to override with another service (e.g. a
// Formspree form URL: https://formspree.io/f/xxxxxxx). If the endpoint fails,
// the form falls back to a pre-filled `mailto:` link.
const QUOTE_EMAIL = 'contact@protex-epi.com';
const endpoint = (import.meta.env.PUBLIC_QUOTE_FORM_ENDPOINT as string | undefined) ?? `https://formsubmit.co/ajax/${QUOTE_EMAIL}`;
---

<form
	class="grid gap-4"
	data-quote-form
	data-endpoint={endpoint ?? ''}
	data-quote-email={QUOTE_EMAIL}
	data-msg-submitting={t('quote.form.submitting')}
	data-msg-success={t('quote.form.success')}
	data-msg-error={t('quote.form.error')}
	data-msg-mailto={t('quote.form.mailtoInfo')}
	data-submit-label={t('quote.form.submit')}
	data-label-product={t('quote.form.product')}
	data-label-name={t('quote.form.name')}
	data-label-company={t('quote.form.company')}
	data-label-email={t('quote.form.email')}
	data-label-phone={t('quote.form.phone')}
	data-label-quantity={t('quote.form.quantity')}
	data-label-message={t('quote.form.message')}
>
	{/* Champs de service FormSubmit : sujet, anti-spam, pas de captcha. */}
	<input type="hidden" name="_subject" value="Demande de devis — protex-epi.com" />
	<input type="hidden" name="_template" value="table" />
	<input type="hidden" name="_captcha" value="false" />
	<input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

	<div class="relative">
		<label for="quote-product" class="mb-1 block text-sm font-medium text-gray-900">
			{t('quote.form.product')}
		</label>
		<input
			id="quote-product"
			name="product"
			type="text"
			autocomplete="off"
			placeholder={t('quote.form.productPlaceholder')}
			class="w-full rounded-md border border-gray-300 px-3 py-2 text-gray-700 focus:border-gray-500 focus:outline-none"
		/>
		<ul
			data-product-suggestions
			class="absolute left-0 right-0 top-full z-30 mt-1 hidden max-h-64 overflow-y-auto rounded-md border border-gray-200 bg-white p-1 shadow-lg"
		>
		</ul>
	</div>

	<div class="grid gap-4 sm:grid-cols-2">
		<div>
			<label for="quote-name" class="mb-1 block text-sm font-medium text-gray-900">
				{t('quote.form.name')} *
			</label>
			<input
				id="quote-name"
				name="name"
				type="text"
				required
				class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
			/>
		</div>
		<div>
			<label for="quote-company" class="mb-1 block text-sm font-medium text-gray-900">
				{t('quote.form.company')}
			</label>
			<input
				id="quote-company"
				name="company"
				type="text"
				class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
			/>
		</div>
	</div>

	<div class="grid gap-4 sm:grid-cols-2">
		<div>
			<label for="quote-email" class="mb-1 block text-sm font-medium text-gray-900">
				{t('quote.form.email')} *
			</label>
			<input
				id="quote-email"
				name="email"
				type="email"
				required
				class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
			/>
		</div>
		<div>
			<label for="quote-phone" class="mb-1 block text-sm font-medium text-gray-900">
				{t('quote.form.phone')}
			</label>
			<input
				id="quote-phone"
				name="phone"
				type="tel"
				class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
			/>
		</div>
	</div>

	<div class="sm:w-48">
		<label for="quote-quantity" class="mb-1 block text-sm font-medium text-gray-900">
			{t('quote.form.quantity')}
		</label>
		<input
			id="quote-quantity"
			name="quantity"
			type="number"
			min="1"
			step="1"
			class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
		/>
	</div>

	<div>
		<label for="quote-message" class="mb-1 block text-sm font-medium text-gray-900">
			{t('quote.form.message')}
		</label>
		<textarea
			id="quote-message"
			name="message"
			rows="4"
			placeholder={t('quote.form.messagePlaceholder')}
			class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-gray-500 focus:outline-none"
		></textarea>
	</div>

	<p class="text-xs text-gray-500">{t('quote.form.requiredHint')} (*)</p>

	<div data-form-status role="status" aria-live="polite" class="hidden rounded-md p-3 text-sm"></div>

	<button
		type="submit"
		data-submit-button
		class="inline-flex w-fit items-center rounded-md bg-blue-600 px-6 py-3 font-medium text-white transition-colors hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-60"
	>
		{t('quote.form.submit')}
	</button>
</form>

<script>
	interface PagefindApi {
		search(query: string): Promise<{
			results: { data(): Promise<{ url: string; meta?: { title?: string } }> }[];
		}>;
	}

	// Comme dans SearchBox : le module pagefind est généré après le build Vite,
	// l'import passe par `new Function` pour échapper à l'analyse statique.
	let pagefind: PagefindApi | null = null;
	let pagefindFailed = false;
	const dynamicImport = new Function('path', 'return import(path)') as (path: string) => Promise<PagefindApi>;

	async function ensurePagefind() {
		if (pagefind || pagefindFailed) return pagefind;
		try {
			pagefind = await dynamicImport('/pagefind/pagefind.js');
		} catch {
			pagefindFailed = true;
		}
		return pagefind;
	}

	function debounce<T extends (...args: never[]) => void>(fn: T, delay: number) {
		let timer: ReturnType<typeof setTimeout>;
		return (...args: Parameters<T>) => {
			clearTimeout(timer);
			timer = setTimeout(() => fn(...args), delay);
		};
	}

	// Suggestions de produits sous le champ « Produit concerné » : recherche
	// dans l'index du site, restreinte aux pages produit du catalogue.
	function initProductSuggestions(form: HTMLFormElement, productField: HTMLInputElement) {
		const list = form.querySelector<HTMLUListElement>('[data-product-suggestions]');
		if (!list) return;

		function hide() {
			list!.classList.add('hidden');
			list!.replaceChildren();
		}

		const run = debounce(async (query: string) => {
			if (query.trim().length < 2) {
				hide();
				return;
			}
			const pf = await ensurePagefind();
			if (!pf) return;
			const search = await pf.search(query);
			const entries = (await Promise.all(search.results.slice(0, 20).map((result) => result.data())))
				.filter((entry) => entry.url.includes('/produits/') || entry.url.includes('/en/products/'))
				.slice(0, 8);
			list!.replaceChildren();
			if (entries.length === 0) {
				hide();
				return;
			}
			for (const entry of entries) {
				const li = document.createElement('li');
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'block w-full rounded-md px-3 py-2 text-left text-sm text-gray-900 hover:bg-gray-50';
				button.textContent = entry.meta?.title ?? entry.url;
				button.addEventListener('click', () => {
					productField.value = entry.meta?.title ?? '';
					hide();
					productField.focus();
				});
				li.appendChild(button);
				list!.appendChild(li);
			}
			list!.classList.remove('hidden');
		}, 150);

		productField.addEventListener('input', () => run(productField.value));
		document.addEventListener('click', (event) => {
			if (!list.contains(event.target as Node) && event.target !== productField) hide();
		});
	}

	function initQuoteForms() {
		document.querySelectorAll<HTMLFormElement>('[data-quote-form]').forEach((form) => {
			const params = new URLSearchParams(window.location.search);
			const productField = form.querySelector<HTMLInputElement>('#quote-product');
			const productName = params.get('product');
			const productSku = params.get('sku');
			if (productField && productName) {
				productField.value = productSku ? `${productName} (${productSku})` : productName;
			}
			if (productField) initProductSuggestions(form, productField);

			const endpoint = form.dataset.endpoint;
			const quoteEmail = form.dataset.quoteEmail ?? '';
			const statusEl = form.querySelector<HTMLElement>('[data-form-status]');
			const submitButton = form.querySelector<HTMLButtonElement>('[data-submit-button]');

			function showStatus(message: string, kind: 'info' | 'success' | 'error') {
				if (!statusEl) return;
				statusEl.textContent = message;
				statusEl.classList.remove('hidden', 'bg-blue-50', 'text-blue-700', 'bg-green-50', 'text-green-700', 'bg-red-50', 'text-red-700');
				if (kind === 'success') statusEl.classList.add('bg-green-50', 'text-green-700');
				else if (kind === 'error') statusEl.classList.add('bg-red-50', 'text-red-700');
				else statusEl.classList.add('bg-blue-50', 'text-blue-700');
			}

			function fieldValue(name: string) {
				return (form.elements.namedItem(name) as HTMLInputElement | HTMLTextAreaElement | null)?.value.trim() ?? '';
			}

			function buildMailtoUrl() {
				const lines = [
					[form.dataset.labelProduct, fieldValue('product')],
					[form.dataset.labelName, fieldValue('name')],
					[form.dataset.labelCompany, fieldValue('company')],
					[form.dataset.labelEmail, fieldValue('email')],
					[form.dataset.labelPhone, fieldValue('phone')],
					[form.dataset.labelQuantity, fieldValue('quantity')],
				]
					.filter(([, value]) => value)
					.map(([label, value]) => `${label} : ${value}`);

				const message = fieldValue('message');
				const body = [...lines, '', form.dataset.labelMessage ?? '', message].join('\n');
				const subject = fieldValue('product')
					? `Demande de devis — ${fieldValue('product')}`
					: 'Demande de devis';

				return `mailto:${quoteEmail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
			}

			function submitViaMailto() {
				window.location.href = buildMailtoUrl();
				showStatus(form.dataset.msgMailto ?? '', 'info');
			}

			if (!endpoint) {
				form.addEventListener('submit', (event) => {
					event.preventDefault();
					if (!form.reportValidity()) return;
					submitViaMailto();
				});
				return;
			}

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!submitButton) return;
				submitButton.disabled = true;
				submitButton.textContent = form.dataset.msgSubmitting ?? '';
				showStatus('', 'info');
				statusEl?.classList.add('hidden');

				try {
					const response = await fetch(endpoint, {
						method: 'POST',
						headers: { Accept: 'application/json' },
						body: new FormData(form),
					});
					// FormSubmit répond 200 avec { success: "false" } tant que
					// l'adresse n'est pas activée : on vérifie aussi ce drapeau.
					const payload = await response.json().catch(() => null);
					const succeeded =
						response.ok && (payload?.success === undefined || String(payload.success) === 'true');
					if (succeeded) {
						form.reset();
						showStatus(form.dataset.msgSuccess ?? '', 'success');
					} else {
						submitViaMailto();
					}
				} catch {
					submitViaMailto();
				} finally {
					submitButton.disabled = false;
					submitButton.textContent = form.dataset.submitLabel ?? '';
				}
			});
		});
	}

	initQuoteForms();
</script>
