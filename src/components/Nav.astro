---
import { categoryTaxonomy } from '../data/category-taxonomy';
import { getCatalogRootUrl, getCategoryUrl, getSubcategoryUrl, type Lang } from '../utils/catalog';
import { useTranslations } from '../i18n/utils';
import LanguagePicker from './LanguagePicker.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === 'en' ? '/en' : '/';
const universes = categoryTaxonomy.filter((category) => category.slug !== 'a-trier');

const linkClass = 'rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100';
const subLinkClass = 'block rounded-md px-3 py-2 text-sm text-gray-600 hover:bg-gray-100 hover:text-gray-900';

const chevron =
	'M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z';
---

<nav class="relative flex items-center" aria-label={t('nav.products')}>
	<ul class="hidden lg:flex lg:items-center lg:gap-1">
		<li>
			<a href={homeHref} class={linkClass}>{t('nav.home')}</a>
		</li>
		{
			universes.map((category) => (
				<li class="group relative">
					{category.subcategories.length > 0 ? (
						<>
							<a href={getCategoryUrl(lang, category.slug)} class={`flex items-center gap-1 ${linkClass}`}>
								{category.labels[lang]}
								<svg class="h-3 w-3 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
									<path fill-rule="evenodd" d={chevron} clip-rule="evenodd" />
								</svg>
							</a>
							<div class="invisible absolute left-0 top-full z-50 min-w-56 rounded-lg border border-gray-200 bg-white p-2 opacity-0 shadow-lg transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
								<ul>
									{category.subcategories.map((subcategory) => (
										<li>
											<a href={getSubcategoryUrl(lang, category.slug, subcategory.slug)} class={subLinkClass}>
												{subcategory.labels[lang]}
											</a>
										</li>
									))}
								</ul>
							</div>
						</>
					) : (
						<a href={getCategoryUrl(lang, category.slug)} class={`block ${linkClass}`}>
							{category.labels[lang]}
						</a>
					)}
				</li>
			))
		}
		<li>
			<a href={getCatalogRootUrl(lang)} class={linkClass}>{t('nav.products')}</a>
		</li>
	</ul>

	<div class="hidden lg:ml-4 lg:block">
		<LanguagePicker />
	</div>

	<input type="checkbox" id="nav-toggle" class="peer sr-only" />
	<label
		for="nav-toggle"
		class="flex h-10 w-10 cursor-pointer items-center justify-center rounded-md text-gray-700 hover:bg-gray-100 peer-checked:hidden lg:hidden"
		aria-label={t('nav.menu')}
	>
		<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
		</svg>
	</label>
	<label
		for="nav-toggle"
		class="hidden h-10 w-10 cursor-pointer items-center justify-center rounded-md text-gray-700 hover:bg-gray-100 peer-checked:flex lg:hidden lg:peer-checked:hidden"
		aria-label={t('nav.close')}
	>
		<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
		</svg>
	</label>

	<div class="fixed inset-x-0 top-16 z-40 hidden max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-gray-200 bg-white px-4 py-4 shadow-lg peer-checked:block lg:hidden">
		<ul class="flex flex-col gap-1">
			<li>
				<a href={homeHref} class={`block ${linkClass}`}>{t('nav.home')}</a>
			</li>
			{
				universes.map((category) =>
					category.subcategories.length > 0 ? (
						<li>
							<details class="group">
								<summary class={`flex cursor-pointer list-none items-center justify-between ${linkClass}`}>
									{category.labels[lang]}
									<svg
										class="h-3 w-3 text-gray-400 transition-transform group-open:rotate-180"
										viewBox="0 0 20 20"
										fill="currentColor"
										aria-hidden="true"
									>
										<path fill-rule="evenodd" d={chevron} clip-rule="evenodd" />
									</svg>
								</summary>
								<ul class="mt-1 flex flex-col gap-1 pl-4">
									<li>
										<a href={getCategoryUrl(lang, category.slug)} class={subLinkClass}>
											{category.labels[lang]}
										</a>
									</li>
									{category.subcategories.map((subcategory) => (
										<li>
											<a href={getSubcategoryUrl(lang, category.slug, subcategory.slug)} class={subLinkClass}>
												{subcategory.labels[lang]}
											</a>
										</li>
									))}
								</ul>
							</details>
						</li>
					) : (
						<li>
							<a href={getCategoryUrl(lang, category.slug)} class={`block ${linkClass}`}>
								{category.labels[lang]}
							</a>
						</li>
					),
				)
			}
			<li>
				<a href={getCatalogRootUrl(lang)} class={`block ${linkClass}`}>{t('nav.products')}</a>
			</li>
		</ul>
		<div class="mt-4 border-t border-gray-200 pt-4">
			<LanguagePicker />
		</div>
	</div>
</nav>
