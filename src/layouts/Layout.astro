---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';
import Analytics from '../components/Analytics.astro';
import type { Lang } from '../utils/catalog';

interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
	image?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, noindex = false, image, jsonLd } = Astro.props;

const lang = (Astro.currentLocale ?? 'fr') as Lang;
const site = Astro.site ?? new URL(Astro.url.origin);

const FR_ROOT = '/produits';
const EN_ROOT = '/en/products';

// Paires FR ↔ EN des pages hors catalogue (les pages /collectivites/* sont
// couvertes par la règle de préfixe : même chemin, préfixé /en côté anglais).
const PAGE_ALTERNATES: Record<string, string> = {
	'/a-propos': '/en/about',
	'/conditions-generales': '/en/terms',
	'/donnees-personnelles': '/en/privacy',
	'/faq': '/en/faq',
	'/contact': '/en/contact',
	'/devis': '/en/quote',
	'/personnalisation': '/en/customisation',
	'/les-normes': '/en/standards',
	'/guide-marquage': '/en/marking-guide',
	'/merci': '/en/thank-you',
	'/recherche': '/en/search',
};
const PAGE_ALTERNATES_REVERSE = Object.fromEntries(
	Object.entries(PAGE_ALTERNATES).map(([fr, en]) => [en, fr]),
);

function alternatePath(path: string, targetLang: Lang): string {
	const normalized = path !== '/' && path.endsWith('/') ? path.slice(0, -1) : path;
	if (targetLang === 'en') {
		if (normalized === '/') return '/en';
		if (PAGE_ALTERNATES[normalized]) return PAGE_ALTERNATES[normalized];
		if (normalized.startsWith('/collectivites')) return `/en${normalized}`;
		if (path.startsWith(FR_ROOT)) return EN_ROOT + path.slice(FR_ROOT.length);
		return path;
	}
	if (normalized === '/en') return '/';
	if (PAGE_ALTERNATES_REVERSE[normalized]) return PAGE_ALTERNATES_REVERSE[normalized];
	if (normalized.startsWith('/en/collectivites')) return normalized.slice('/en'.length);
	if (path.startsWith(EN_ROOT)) return FR_ROOT + path.slice(EN_ROOT.length);
	return path;
}

const canonicalURL = new URL(Astro.url.pathname, site);
const frURL = new URL(alternatePath(Astro.url.pathname, 'fr'), site);
const enURL = new URL(alternatePath(Astro.url.pathname, 'en'), site);

const ogImage = image ? new URL(image, site).toString() : undefined;

const organizationJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: 'Protex EPI',
	url: site.toString(),
	email: 'contact@protex-epi.com',
	telephone: '+33 5 57 02 75 87',
	address: {
		'@type': 'PostalAddress',
		streetAddress: '4 Rue la Motte Picquet',
		addressLocality: 'Bordeaux',
		postalCode: '33300',
		addressCountry: 'FR',
	},
};

const jsonLdBlocks = [organizationJsonLd, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#0071CE" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />

		<link rel="canonical" href={canonicalURL.toString()} />
		<link rel="alternate" hreflang="fr" href={frURL.toString()} />
		<link rel="alternate" hreflang="en" href={enURL.toString()} />
		<link rel="alternate" hreflang="x-default" href={frURL.toString()} />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Protex EPI" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalURL.toString()} />
		{ogImage && <meta property="og:image" content={ogImage} />}
		<meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		{ogImage && <meta name="twitter:image" content={ogImage} />}

		{jsonLdBlocks.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />)}
	</head>
	<body>
		<Header />
		<slot />
		<Footer lang={lang} />
		<CookieConsent lang={lang} />
		<Analytics />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
