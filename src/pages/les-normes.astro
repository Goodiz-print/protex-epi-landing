---
import Layout from '~/layouts/Layout.astro';
import NormesPage from '~/components/content/NormesPage.astro';
import { standardsCopy } from '~/data/standards-copy';
import { ui } from '~/i18n/ui';

const lang = 'fr' as const;
---

<Layout title={`${standardsCopy.metaTitle[lang]} — ${ui.fr['site.title']}`} description={standardsCopy.metaDescription[lang]}>
	<NormesPage lang={lang} />
</Layout>
