---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';

const lang = 'fr' as const;
const t = useTranslations(lang);
const title = t('footer.legal.history');
const description = 'La mission de Protex EPI : équiper les professionnels avec des EPI certifiés et adaptés à leur métier.';
---

<!-- TODO: replace with the company's real founding story / timeline once provided by the business. -->
<Layout title={`${title} — ${ui.fr['site.title']}`} description={description}>
	<main class="mx-auto max-w-3xl px-4 py-10">
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: '/' }, { label: title }]} />
		<h1 class="mb-6 text-2xl font-semibold text-gray-900">{title}</h1>
		<div class="space-y-4 text-gray-700">
			<p>
				Protex EPI accompagne les entreprises dans l'équipement et la protection de leurs équipes sur le terrain.
				En s'appuyant sur des marques reconnues du secteur — Portwest, Blaklader, Mascot — et sur une expertise
				des normes de sécurité en vigueur, Protex EPI construit un catalogue pensé pour répondre aux exigences
				des métiers exposés à des risques professionnels.
			</p>
			<p>
				Notre approche reste la même à chaque demande : comprendre le besoin, proposer les équipements adaptés
				et accompagner nos clients jusqu'à la livraison.
			</p>
		</div>
	</main>
</Layout>
