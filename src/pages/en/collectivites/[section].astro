---
import Layout from '~/layouts/Layout.astro';
import SelectionPage from '~/components/catalog/SelectionPage.astro';
import QuoteCta from '~/components/home/QuoteCta.astro';
import { getCollectiviteSectionStaticPaths, getProductsBySelection } from '~/content/queries';
import { getCollectivitesUrl, getCollectiviteSectionUrl } from '~/utils/catalog';
import { ui } from '~/i18n/ui';
import { selectionDescription } from '~/utils/seo';

export async function getStaticPaths() {
	return getCollectiviteSectionStaticPaths();
}

const { selection } = Astro.props;
const products = await getProductsBySelection(selection);
---

<Layout
	title={`${selection.labels.en} — ${ui.en['collectivites.title']} — ${ui.en['site.title']}`}
	description={selectionDescription(selection, 'en')}
>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<SelectionPage
			lang="en"
			selection={selection}
			products={products}
			payloadUrl={`${getCollectiviteSectionUrl('en', selection.slug)}/listing.json`}
			parent={{ label: ui.en['collectivites.title'], href: getCollectivitesUrl('en') }}
		/>
	</main>
	<QuoteCta lang="en" />
</Layout>
