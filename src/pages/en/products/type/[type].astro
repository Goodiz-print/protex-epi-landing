---
import Layout from '~/layouts/Layout.astro';
import GarmentTypePage from '~/components/catalog/GarmentTypePage.astro';
import { getGarmentTypeStaticPaths, getProductsByGarmentType } from '~/content/queries';
import { ui } from '~/i18n/ui';
import { garmentTypeDescription } from '~/utils/seo';

export async function getStaticPaths() {
	return getGarmentTypeStaticPaths();
}

const { garmentType } = Astro.props;
const products = await getProductsByGarmentType(garmentType);
---

<Layout
	title={`${garmentType.labels.en} — ${ui.en['site.title']}`}
	description={garmentTypeDescription(garmentType, 'en')}
>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<GarmentTypePage lang="en" garmentType={garmentType} products={products} />
	</main>
</Layout>
