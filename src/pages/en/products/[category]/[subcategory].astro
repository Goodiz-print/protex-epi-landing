---
import Layout from '~/layouts/Layout.astro';
import SubcategoryPage from '~/components/catalog/SubcategoryPage.astro';
import { getSubcategoryStaticPaths, getProductsBySubcategory } from '~/content/queries';
import { ui } from '~/i18n/ui';
import { subcategoryDescription } from '~/utils/seo';

export async function getStaticPaths() {
	return getSubcategoryStaticPaths();
}

const { category, subcategory } = Astro.props;
const products = await getProductsBySubcategory(category.slug, subcategory.slug);
---

<Layout
	title={`${subcategory.labels.en} — ${ui.en['site.title']}`}
	description={subcategoryDescription(category, subcategory, 'en')}
>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<SubcategoryPage lang="en" category={category} subcategory={subcategory} products={products} />
	</main>
</Layout>
