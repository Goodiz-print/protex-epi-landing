---
import Layout from '~/layouts/Layout.astro';
import SelectionPage from '~/components/catalog/SelectionPage.astro';
import QuoteCta from '~/components/home/QuoteCta.astro';
import { getCollectivitesProducts } from '~/content/queries';
import { getCollectivitesUrl } from '~/utils/catalog';
import { ui } from '~/i18n/ui';

const products = await getCollectivitesProducts();
---

<Layout title={`${ui.en['collectivites.title']} — ${ui.en['site.title']}`} description={ui.en['collectivites.intro']}>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<SelectionPage
			lang="en"
			title={ui.en['collectivites.title']}
			intro={ui.en['collectivites.intro']}
			products={products}
			payloadUrl={`${getCollectivitesUrl('en')}/listing.json`}
		/>
	</main>
	<QuoteCta lang="en" />
</Layout>
