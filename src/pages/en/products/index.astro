---
import Layout from '~/layouts/Layout.astro';
import CatalogRootPage from '~/components/catalog/CatalogRootPage.astro';
import { ui } from '~/i18n/ui';
import { catalogDescription } from '~/utils/seo';
---

<Layout
	title={`${ui.en['catalog.breadcrumb.products']} — ${ui.en['site.title']}`}
	description={catalogDescription('en')}
>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<CatalogRootPage lang="en" />
	</main>
</Layout>
