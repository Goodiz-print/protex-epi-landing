---
import Layout from '~/layouts/Layout.astro';
import Button from '~/components/ui/Button.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
const title = t('quote.thanks.title');
---

<Layout title={`${title} — ${ui.en['site.title']}`} description={t('quote.form.success')} noindex>
	<main class="mx-auto flex min-h-[50vh] max-w-2xl flex-col items-center justify-center px-4 py-16 text-center">
		<span class="mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-green-50 text-green-600" aria-hidden="true">
			<svg width="26" height="26" viewBox="0 0 24 24" fill="none">
				<path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</span>
		<h1 class="mb-3 text-2xl font-semibold text-gray-900">{t('quote.form.success')}</h1>
		<p class="mb-8 text-gray-700">{t('quote.thanks.body')}</p>
		<Button href="/en" variant="primary">{t('quote.thanks.backHome')}</Button>
	</main>
</Layout>
