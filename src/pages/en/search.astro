---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import SearchResults from '~/components/SearchResults.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
const title = t('search.pageTitle');
---

<Layout title={`${title} — ${ui.en['site.title']}`} description={t('search.intro')} noindex>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: '/en' }, { label: title }]} />
		<h1 class="mb-2 font-heading text-3xl font-bold uppercase text-gray-900">{title}</h1>
		<p class="mb-6 text-gray-600">{t('search.intro')}</p>
		<SearchResults lang={lang} />
	</main>
</Layout>
