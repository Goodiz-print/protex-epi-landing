---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';
import broderieLogo from '~/assets/images/personnalisation/broderie-logo.png';

const lang = 'en' as const;
const t = useTranslations(lang);
const title = t('footer.legal.markingGuide');
const description =
	'Protex EPI marking processes guide: embroidery, screen printing, transfer, digital printing, sublimation, laser engraving and pad printing — pros and cons of each technique.';

const techniques = [
	{
		name: 'Embroidery',
		body: 'The logo is stitched directly into the fabric, with up to 15 thread colours (around 370 shades available). The most premium technique for corporate garments worn every day.',
		pros: ['High-end, representative appearance', 'Excellent mechanical durability and long life', 'Ideal for polos, sweatshirts, jackets, beanies and caps'],
		cons: ['Higher price for sophisticated designs', 'Very large designs can stiffen the fabric', 'Colour gradients cannot be reproduced faithfully'],
	},
	{
		name: 'Screen printing',
		body: 'Ink is pushed through a stencil, colour by colour, up to 8 colours. The reference for smooth, flat surfaces and large runs.',
		pros: ['Durable, high-quality marking with vivid colours', 'Excellent value on large orders', 'Perfect for large formats (jacket backs, vests)'],
		cons: ['Less suited to small runs (set-up costs)', 'Not possible over edges and seams', 'Slightly longer production'],
	},
	{
		name: 'Transfer (heat-applied marking)',
		body: 'The design is printed on a film then heat-pressed onto the fabric. A sharp, precise marking, suited to detailed or multicolour logos, including small runs.',
		pros: ['Sharp details, faithful multicolour logos', 'Suited to small and medium runs', 'Preserves the reflective surfaces of high-visibility garments'],
		cons: ['Slightly less durable than embroidery', 'Sits on the fabric rather than in the fibre'],
	},
	{
		name: 'Digital printing',
		body: 'The design is printed directly onto the fabric, with no screen preparation. It allows photos and full colour, right up to the edges.',
		pros: ['Full-colour designs, photos and gradients possible', 'Printing up to the edges, rough surfaces accepted', 'No set-up costs: ideal for small quantities'],
		cons: ['Exact Pantone shades not guaranteed', 'Mainly for cotton fabrics', 'Expensive on large volumes'],
	},
	{
		name: 'Sublimation',
		body: 'The ink turns into gas at 200°C and penetrates polyester fibres: the design becomes part of the fabric, with maximum preservation of shades.',
		pros: ['Full-colour photo printing with no perceptible touch', 'Large surfaces possible', 'Short lead times'],
		cons: ['Polyester only (usually light backgrounds)', 'Pantone shades hard to guarantee'],
	},
	{
		name: 'Laser engraving',
		body: 'The laser engraves the design directly into the material — metal, wood, plastic and fleece fabrics. A sober, permanent tone-on-tone finish.',
		pros: ['Very high durability, precise logo', 'Elegant, discreet, ink-free finish', 'Suited to accessories (tools, bottles) and fleece'],
		cons: ['No colour choice (tone-on-tone finish)', 'Compatible materials only', 'Very fine details not possible on fleece'],
	},
	{
		name: 'Pad printing',
		body: 'A soft pad deposits the ink on the object: the industrial reference for small logos (up to 7 cm) on objects and accessories, up to 4 colours.',
		pros: ['Specific Pantone colours possible', 'Economical on large runs', 'Suited to small objects (helmets, accessories)'],
		cons: ['Small designs only, no smooth gradients', 'Less durable than engraving', 'Complex surfaces are problematic'],
	},
];
---

<Layout title={`${title} — ${ui.en['site.title']}`} description={description}>
	<main class="mx-auto max-w-3xl px-4 py-10">
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: '/en' }, { label: title }]} />
		<h1 class="mb-6 text-2xl font-semibold text-gray-900">Marking processes guide</h1>
		<div class="space-y-6 text-gray-700">
			<p>
				Every fabric and every volume calls for a different marking technique. This guide covers the processes we use
				on PPE, workwear and their accessories. For tailored advice, see the
				<a href="/en/customisation" class="font-medium text-brand hover:text-brand-dark">Customisation</a> page
				or <a href="/en/quote" class="font-medium text-brand hover:text-brand-dark">request a quote</a>.
			</p>
			<Image src={broderieLogo} alt="Logo being embroidered on a machine" width={1200} height={800} class="rounded-lg" />
			{
				techniques.map((technique) => (
					<section class="rounded-lg border border-gray-200 p-5">
						<h2 class="mb-2 font-heading text-lg font-bold text-gray-900">{technique.name}</h2>
						<p class="mb-3">{technique.body}</p>
						<div class="grid gap-4 sm:grid-cols-2">
							<div>
								<h3 class="mb-1 text-sm font-semibold text-green-700">Pros</h3>
								<ul class="list-inside list-disc space-y-1 text-sm">
									{technique.pros.map((pro) => <li>{pro}</li>)}
								</ul>
							</div>
							<div>
								<h3 class="mb-1 text-sm font-semibold text-gray-500">Limitations</h3>
								<ul class="list-inside list-disc space-y-1 text-sm">
									{technique.cons.map((con) => <li>{con}</li>)}
								</ul>
							</div>
						</div>
					</section>
				))
			}
			<p>
				All customisation complies with the standards applicable to PPE (Regulation (EU) 2016/425) — see also
				<a href="/en/standards" class="font-medium text-brand hover:text-brand-dark">our standards page</a>.
			</p>
		</div>
	</main>
</Layout>
