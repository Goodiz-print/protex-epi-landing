---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import Button from '~/components/ui/Button.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';
import equipeChantier from '~/assets/images/personnalisation/equipe-chantier.jpg';
import broderieImage from '~/assets/images/personnalisation/broderie.jpg';
import transfertImage from '~/assets/images/personnalisation/transfert.jpg';
import serigraphieImage from '~/assets/images/personnalisation/serigraphie.jpg';
import poloBroderie from '~/assets/images/personnalisation/polo-broderie.jpg';
import vesteHvDos from '~/assets/images/personnalisation/veste-hv-dos.jpg';
import couvreChefs from '~/assets/images/personnalisation/couvre-chefs.jpg';

const lang = 'en' as const;
const t = useTranslations(lang);
const title = 'Customising your PPE and workwear';
const description =
	'Assert your company identity: embroidery, transfer or screen printing on your PPE and workwear, in full compliance with applicable safety standards.';

const techniques = [
	{
		name: 'Embroidery',
		image: broderieImage,
		body: 'The most durable and premium option: your logo is stitched into the fabric. Ideal for polos, sweatshirts, jackets, beanies and caps worn every day — it withstands repeated washing and keeps a high-end finish over time.',
	},
	{
		name: 'Transfer',
		image: transfertImage,
		body: 'A sharp, precise marking suited to small and medium runs as well as detailed or multicolour logos. Transfer is particularly appropriate for high-visibility garments, as it preserves the mandatory reflective surfaces and the garment’s compliance.',
	},
	{
		name: 'Screen printing',
		image: serigraphieImage,
		body: 'The reference technique for large runs and large formats: vivid colours, excellent value for money and a consistent finish across the whole fleet. Perfect for t-shirts, vests and back-printed jackets.',
	},
];

const steps = [
	{ title: 'Choose your equipment', body: 'Pick your PPE and workwear from our catalog.' },
	{ title: 'Send us your logo', body: 'Share your logo or brand guidelines.' },
	{
		title: 'Technical advice',
		body: 'We recommend the right technique and placements for the fabric, the volume and the conditions of use.',
	},
	{ title: 'Approve the marking', body: 'You approve a precise mock-up before anything goes to production.' },
	{ title: 'Production and delivery', body: 'We produce and deliver your customised equipment.' },
];

const benefits = [
	'Strengthen your company image with a consistent look across the whole fleet',
	'Clearly identify your teams on site and in public',
	'Reinforce the professionalism perceived by your customers',
	'Grow your brand visibility every day',
];
---

<Layout title={`${title} — ${ui.en['site.title']}`} description={description}>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: '/en' }, { label: 'Customisation' }]} />
		<h1 class="mb-6 font-heading text-3xl font-bold uppercase text-gray-900">Customisation</h1>

		<div class="grid items-center gap-8 lg:grid-cols-2">
			<div class="space-y-4 text-gray-700">
				<p class="text-lg font-medium text-gray-900">{title}</p>
				<p>
					Customising your equipment asserts your company identity and boosts your brand visibility, on site and in
					the workshop. High-resistance marking designed for demanding environments, several techniques depending on
					volumes and fabrics, and full support from design to delivery.
				</p>
				<p>
					All customisation is carried out in compliance with the safety standards applicable to personal protective
					equipment (Regulation (EU) 2016/425): on high-visibility garments, the mandatory reflective surfaces are
					preserved.
				</p>
			</div>
			<Image src={equipeChantier} alt="Construction team wearing PPE customised with their company logo" width={1200} height={800} class="rounded-lg" />
		</div>

		<h2 class="mb-4 mt-12 font-heading text-2xl font-bold uppercase text-gray-900">What can be customised?</h2>
		<div class="grid gap-4 sm:grid-cols-3">
			<figure class="overflow-hidden rounded-lg border border-gray-200">
				<Image src={poloBroderie} alt="Black polo shirt embroidered with a company logo on the chest" width={600} height={600} class="h-48 w-full object-cover" />
				<figcaption class="p-4 text-sm text-gray-700">
					<strong class="text-gray-900">Workwear</strong> — t-shirts, polos, sweatshirts, jackets, trousers and
					padded jackets from our ranges.
				</figcaption>
			</figure>
			<figure class="overflow-hidden rounded-lg border border-gray-200">
				<Image src={vesteHvDos} alt="High-visibility jacket with a large logo printed on the back" width={600} height={600} class="h-48 w-full object-cover object-top" />
				<figcaption class="p-4 text-sm text-gray-700">
					<strong class="text-gray-900">High-visibility clothing</strong> — compliant marking, reflective surfaces
					preserved.
				</figcaption>
			</figure>
			<figure class="overflow-hidden rounded-lg border border-gray-200">
				<Image src={couvreChefs} alt="Beanie, safety helmet and cap customised with a logo" width={600} height={600} class="h-48 w-full object-cover" />
				<figcaption class="p-4 text-sm text-gray-700">
					<strong class="text-gray-900">Helmets, caps and beanies</strong> — customisable depending on each item’s
					compatibility.
				</figcaption>
			</figure>
		</div>

		<h2 class="mb-4 mt-12 font-heading text-2xl font-bold uppercase text-gray-900">Our marking techniques</h2>
		<div class="grid gap-4 sm:grid-cols-3">
			{
				techniques.map((technique) => (
					<article class="overflow-hidden rounded-lg border border-gray-200">
						<Image src={technique.image} alt={`${technique.name} on professional clothing`} width={600} height={400} class="h-44 w-full object-cover" />
						<div class="p-4">
							<h3 class="mb-2 font-heading text-lg font-bold text-gray-900">{technique.name}</h3>
							<p class="text-sm text-gray-700">{technique.body}</p>
						</div>
					</article>
				))
			}
		</div>
		<p class="mt-4 text-gray-700">
			Each technique adapts to the fabric, the volume and the conditions of use to guarantee durability and compliance.
			For the details of every process,
			<a href="/en/marking-guide" class="font-medium text-brand hover:text-brand-dark">see our marking guide</a>.
		</p>

		<h2 class="mb-4 mt-12 font-heading text-2xl font-bold uppercase text-gray-900">How it works</h2>
		<ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
			{
				steps.map((step, index) => (
					<li class="rounded-lg border border-gray-200 p-4">
						<span class="mb-2 flex h-8 w-8 items-center justify-center rounded-full bg-brand font-heading font-bold text-white">
							{index + 1}
						</span>
						<h3 class="mb-1 font-semibold text-gray-900">{step.title}</h3>
						<p class="text-sm text-gray-700">{step.body}</p>
					</li>
				))
			}
		</ol>

		<h2 class="mb-4 mt-12 font-heading text-2xl font-bold uppercase text-gray-900">Why customise your equipment?</h2>
		<ul class="grid gap-3 sm:grid-cols-2">
			{
				benefits.map((benefit) => (
					<li class="flex gap-3 text-gray-700">
						<svg class="mt-1 h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path
								fill-rule="evenodd"
								d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
								clip-rule="evenodd"
							/>
						</svg>
						{benefit}
					</li>
				))
			}
		</ul>

		<div class="mt-12 rounded-lg bg-gray-50 p-8 text-center">
			<p class="mb-4 font-heading text-xl font-bold text-gray-900">Planning a customisation project?</p>
			<p class="mb-6 text-gray-700">Answer within 24h — no obligation.</p>
			<Button href="/en/quote" variant="primary">Request my quote</Button>
		</div>
	</main>
</Layout>
