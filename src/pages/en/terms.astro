---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
const title = t('footer.legal.terms');
const description = 'General terms and conditions of sale of PROTEX EPI (SAS GOODIZ PRINT).';

// Translation of the client-provided CGV; the French version prevails (see notice below).
const articles: { heading: string; paragraphs: string[] }[] = [
	{
		heading: '1. General',
		paragraphs: [
			'Our products, catalog and website www.protex-epi.com are reserved exclusively for companies, works councils, local authorities, businesses and associations. By placing an order with us, the buyer accepts our general terms and conditions and waives their own. Any order placed implies acceptance of our general terms and conditions of sale. The personal protective equipment (PPE) and workwear shown in our catalogs and websites are not contractual. We reserve the right to make any technical or aesthetic modification we deem necessary, always with a view to improvement. All products shown in our catalogs and websites bearing commercial logos or registered trademarks are given as examples only.',
		],
	},
	{
		heading: '2. Quotes',
		paragraphs: [
			'Quotes given over the phone are estimates and cannot be considered contractual. Such quotes may be confirmed, where applicable, by our sales department by e-mail.',
		],
	},
	{
		heading: '3. Orders',
		paragraphs: [
			'Every order must be the subject of a written instruction (either our quote or pro forma returned by e-mail, dated and signed with the words: Read and approved – Order confirmed – or a purchase order restating the terms and conditions of our quote on letterhead). For technical reasons, we reserve the right to deliver and invoice plus or minus 5% of the quantities ordered.',
		],
	},
	{
		heading: '4. Samples',
		paragraphs: [
			'Any sample request must be made in writing (post or e-mail). Samples are invoiced at the wholesale price plus a €15 excl. VAT handling fee.',
		],
	},
	{
		heading: '5. Prices',
		paragraphs: [
			'Our prices are exclusive of tax (VAT 20%). They are indicative and may be revised in the event of currency fluctuations, changes in raw material prices (textiles, leather, technical components) or in the taxation in force on the day of delivery. Our base prices may be discounted. Slight differences in colours, sizes or fabric weights, or longer manufacturing lead times, are tolerated by trade practice and cannot under any circumstances give rise to a claim. Our prices are ex Bordeaux unless otherwise agreed.',
		],
	},
	{
		heading: '6. Marking and compliance',
		paragraphs: [
			'Our products can be customised using various processes: screen printing, pad printing, transfer, embroidery, laser engraving or heat-sealed marking, in compliance with the safety standards applicable to personal protective equipment. Working from different bases, we cannot obtain shades and gloss identical to Pantone C references. Given European regulations on heavy metals and solvents, colour pigmentations evolve, which may lead to slight differences in shade depending on the printing process (particularly on coloured backgrounds). Any customisation remains subject to the product’s compliance with the PPE standards in force (Regulation (EU) 2016/425); claims for manufacturing defects are not admissible.',
		],
	},
	{
		heading: '7. Payment terms',
		paragraphs: [
			'A cheque for 50% of the amount including VAT must accompany the order (returned if we cancel, and retained if you cancel, without this giving rise to any compensation). Every customer is subject to an acceptance request with our credit insurance provider. Customers who are refused, or whose delivery deadline is too close to obtain approval, will be asked to pay on order by bank transfer only. For customers with an open account, the balance is payable on receipt of invoice. Any late payment makes all outstanding amounts immediately due. Any delay or postponement of a due date will be invoiced after calculation of late-payment interest and after actual payment. The interest rate is 18% (French law 92-1442 of 31.12.92 on payment terms between businesses). Any late payment automatically gives rise, without any formal notice being required, to late-payment penalties based on the ECB rate plus ten (10) points and to a fixed recovery fee of €40.',
		],
	},
	{
		heading: '8. Delivery times',
		paragraphs: [
			'Once the proof has been approved, delivery takes from 1 week to 4 months depending on the items. These times are indicative. A late delivery cannot under any circumstances give rise to damages, order cancellation, refusal of the goods or postponement of payment.',
		],
	},
	{
		heading: '9. Shipping / Deliveries',
		paragraphs: [
			'Shipped goods travel at the recipient’s risk. In the event of damage, loss or delay, it is the recipient’s responsibility to make the customary reservations with the carrier in order to preserve their rights within the legal deadlines.',
		],
	},
	{
		heading: '10. Retention of title',
		paragraphs: [
			'Pursuant to French law no. 80-335 of 12 May 1980, the transfer of ownership of delivered and invoiced goods is suspended until full payment of the price (applicable to the right of recovery, even in the event of receivership or judicial liquidation). Legal ownership of our items is therefore only transferred to the buyer on the date they have paid the price in full. If the goods are sold in the meantime, the customer must assign the receivable to us, and any payments received on those receivables must be forwarded to us upon receipt. These provisions do not prevent the transfer to the buyer, upon delivery, of the risks of loss or deterioration of the goods sold and of any damage they may cause.',
		],
	},
	{
		heading: '11. Intellectual property',
		paragraphs: [
			'By placing an order with us, you authorise SAS GOODIZ PRINT (trading as PROTEX EPI) to use your logo and name in our catalogs and on our website (examples of customised items, customer references).',
		],
	},
	{
		heading: '12. Personal data and right to object',
		paragraphs: [
			'The information collected by SAS GOODIZ PRINT (PROTEX EPI brand) is collected and recorded by the company for the purpose of performing the service (quotes, orders, delivery, invoicing, handling of any claims, customer relations, satisfaction surveys, etc.).',
			'Only the data strictly necessary for these purposes is kept, for the periods corresponding to each processing operation.',
			'In accordance with the amended French Data Protection Act 78-17 of 6 January 1978 and European Regulation 2016/679 of 27 April 2016, you have a right of access, rectification, restriction, erasure and deletion of your data. You may also object, on legitimate grounds, to the use of your data.',
			'To exercise these rights, you can write by e-mail or post to: contact@protex-epi.com or SAS GOODIZ PRINT, 4 rue la Motte Picquet – 33300 BORDEAUX France, stating “Droit des personnes” in the subject line and enclosing a copy of your proof of identity.',
		],
	},
	{
		heading: '13. Claims',
		paragraphs: ['Any claim must reach us within 48 hours of receipt of the goods, by registered letter.'],
	},
	{
		heading: '14. Product returns',
		paragraphs: [
			'No return can be accepted without the prior written agreement of SAS GOODIZ PRINT. If the Customer returns products without SAS GOODIZ PRINT’s agreement, the products are held at the Customer’s disposal and cannot under any circumstances give rise to a credit note; in that case, the Customer bears the costs and risks of returning the products concerned. SAS GOODIZ PRINT may issue a credit note for a return it deems justified. For hygiene and safety reasons, customised, worn or unpacked PPE cannot be returned.',
		],
	},
	{
		heading: '15. Jurisdiction',
		paragraphs: ['In the event of a dispute, the court of Bordeaux has sole jurisdiction.'],
	},
	{
		heading: '16. Use of the site content by customers and by PROTEX EPI',
		paragraphs: [
			'The entire contents — including the composition and assembly — of the www.protex-epi.com site, including but not limited to texts, graphics, logos, icons, buttons, images, audio clips and software, are elements whose rights are held by SAS GOODIZ PRINT or used with the authorisation of the owner of the rights, trademark or service. The contents are protected by French, European and international law.',
			'SAS GOODIZ PRINT authorises you to copy content from the www.protex-epi.com site solely for non-commercial purposes, within your organisation, and exclusively in connection with the purchase of products from PROTEX EPI. You may print a single copy of the content of this site for your personal use, solely for the purpose of learning about, evaluating or acquiring PROTEX EPI services or products.',
			'Without the express authorisation of SAS GOODIZ PRINT, you may not print, copy, post, reproduce, publish, distribute, transmit, download, record, store, disclose, alter or modify the content of the PROTEX EPI site, including but not limited to electronic, mechanical, photocopying or recording means. You may not use PROTEX EPI icons to create hyperlinks, whether between two other websites or between a website and this site, or use for any reason whatsoever the PROTEX EPI name, registered trademarks or patented designs present on the PROTEX EPI site.',
			'Any authorisation granted is automatically cancelled if you breach any of the above terms or conditions. You must immediately destroy all recorded and/or printed content from this site. Any unauthorised use of any content of this site may violate copyright, trademark, confidentiality, advertising or communications law.',
			'PROTEX EPI asks you to respect its own intellectual property rights as well as the intellectual property rights of others. In particular, by ordering from PROTEX EPI, you certify that you are entitled to use all logos, texts and/or graphics you have submitted to us for customising the selected items. By ordering, you also agree that your name and logo may be used on our Customer References page. SAS GOODIZ PRINT reserves the right, in certain circumstances and at our sole discretion, to refuse or accept orders from customers who have infringed or violated the intellectual property rights of a third party.',
		],
	},
];
---

<Layout title={`${title} — ${ui.en['site.title']}`} description={description} noindex>
	<main class="mx-auto max-w-3xl px-4 py-10">
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: '/en' }, { label: title }]} />
		<h1 class="mb-6 text-2xl font-semibold text-gray-900">General Terms and Conditions of Sale – PROTEX EPI</h1>
		<p class="mb-6 rounded-md bg-gray-50 p-4 text-sm text-gray-600">
			This English translation is provided for convenience only. In the event of any discrepancy, the
			<a href="/conditions-generales" class="font-medium text-brand hover:text-brand-dark">French version</a> prevails.
		</p>
		<div class="space-y-6 text-gray-700">
			{
				articles.map((article) => (
					<section class="space-y-3">
						<h2 class="font-semibold text-gray-900">{article.heading}</h2>
						{article.paragraphs.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</section>
				))
			}
		</div>
	</main>
</Layout>
