---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
const title = t('footer.legal.privacy');
const description = 'Personal data and cookie policy for the Protex EPI website.';
---

<Layout title={`${title} — ${ui.en['site.title']}`} description={description} noindex>
	<main class="mx-auto max-w-3xl px-4 py-10">
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: '/en' }, { label: title }]} />
		<h1 class="mb-4 text-2xl font-semibold text-gray-900">{title}</h1>
		<div class="space-y-6 text-gray-700">
			<section>
				<h2 class="mb-1 font-semibold text-gray-900">Data controller</h2>
				<p>
					SAS GOODIZ PRINT (trading as Protex EPI), {t('footer.contact.addressLine')} — <a href="mailto:contact@protex-epi.com" class="text-blue-700 hover:text-blue-800">contact@protex-epi.com</a>.
				</p>
			</section>
			<section>
				<h2 class="mb-1 font-semibold text-gray-900">Data collected</h2>
				<p>
					The site collects data voluntarily entered in the
					<a href="/en/quote" class="text-blue-700 hover:text-blue-800">quote request form</a>
					 (name, company, email, phone, quantity, message), as well as cookies, based on preferences saved
					through the consent banner:
				</p>
				<ul class="mt-2 list-inside list-disc space-y-1">
					<li><strong>{t('cookie.category.functional')}</strong> — {t('cookie.category.functionalDesc')}</li>
					<li><strong>{t('cookie.category.marketing')}</strong> — {t('cookie.category.marketingDesc')}</li>
					<li><strong>{t('cookie.category.performance')}</strong> — {t('cookie.category.performanceDesc')}</li>
					<li><strong>{t('cookie.category.analytics')}</strong> — {t('cookie.category.analyticsDesc')}</li>
				</ul>
			</section>
			<section>
				<h2 class="mb-1 font-semibold text-gray-900">Purposes</h2>
				<p>Responding to quote requests, operating the site, and, subject to consent, measuring site audience.</p>
			</section>
			<section>
				<h2 class="mb-1 font-semibold text-gray-900">Legal basis</h2>
				<p>Pre-contractual measures for the quote form; consent for non-essential cookies.</p>
			</section>
			<section>
				<h2 class="mb-1 font-semibold text-gray-900">Retention period</h2>
				<ul class="list-inside list-disc space-y-1">
					<li>
						<strong>Quote requests and prospects</strong> — 3 years from your last contact, then deleted or
						anonymised.
					</li>
					<li>
						<strong>Customers</strong> — for the duration of the business relationship, then archived only
						as required by law (accounting records are kept for 10 years under the French Commercial Code).
					</li>
					<li>
						<strong>Cookies</strong> — 13 months maximum; your consent choice is stored for 6 months before
						being requested again.
					</li>
				</ul>
			</section>
			<section>
				<h2 class="mb-1 font-semibold text-gray-900">Hosting</h2>
				<p>
					The www.protex-epi.com website is hosted by OVH SAS, 2 rue Kellermann, 59100 Roubaix, France
					(<a href="https://www.ovhcloud.com" class="text-blue-700 hover:text-blue-800" rel="noopener">www.ovhcloud.com</a>).
					Data is hosted within the European Union.
				</p>
			</section>
			<section>
				<h2 class="mb-1 font-semibold text-gray-900">Your rights</h2>
				<p>
					Under the GDPR and the French Data Protection Act, you have the right to access, rectify, restrict,
					erase and object to your personal data. To exercise these rights, write to
					<a href="mailto:contact@protex-epi.com" class="text-blue-700 hover:text-blue-800">contact@protex-epi.com</a>
					or by post to SAS GOODIZ PRINT, 4 rue la Motte Picquet, 33300 Bordeaux, France, stating “Droit des
					personnes” in the subject line and enclosing a copy of proof of identity. You may also lodge a
					complaint with the CNIL (<a href="https://www.cnil.fr" class="text-blue-700 hover:text-blue-800" rel="noopener">www.cnil.fr</a>).
				</p>
			</section>
		</div>
	</main>
</Layout>
