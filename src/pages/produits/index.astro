---
import Layout from '~/layouts/Layout.astro';
import CatalogRootPage from '~/components/catalog/CatalogRootPage.astro';
import { ui } from '~/i18n/ui';
import { catalogDescription } from '~/utils/seo';
---

<Layout
	title={`${ui.fr['catalog.breadcrumb.products']} — ${ui.fr['site.title']}`}
	description={catalogDescription('fr')}
>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<CatalogRootPage lang="fr" />
	</main>
</Layout>
