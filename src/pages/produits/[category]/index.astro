---
import Layout from '~/layouts/Layout.astro';
import CategoryPage from '~/components/catalog/CategoryPage.astro';
import { getCategoryStaticPaths, getProductsByCategory } from '~/content/queries';
import { ui } from '~/i18n/ui';
import { categoryDescription } from '~/utils/seo';

export async function getStaticPaths() {
	return getCategoryStaticPaths();
}

const { category } = Astro.props;
const products = category.subcategories.length === 0 ? await getProductsByCategory(category.slug) : [];
---

<Layout
	title={`${category.labels.fr} — ${ui.fr['site.title']}`}
	description={categoryDescription(category, 'fr')}
	noindex={category.slug === 'a-trier'}
>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<CategoryPage lang="fr" category={category} products={products} />
	</main>
</Layout>
