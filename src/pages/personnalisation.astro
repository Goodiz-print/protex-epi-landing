---
import { Image } from 'astro:assets';
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import Button from '~/components/ui/Button.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';
import equipeChantier from '~/assets/images/personnalisation/equipe-chantier.jpg';
import broderieImage from '~/assets/images/personnalisation/broderie.jpg';
import transfertImage from '~/assets/images/personnalisation/transfert.jpg';
import serigraphieImage from '~/assets/images/personnalisation/serigraphie.jpg';
import poloBroderie from '~/assets/images/personnalisation/polo-broderie.jpg';
import vesteHvDos from '~/assets/images/personnalisation/veste-hv-dos.jpg';
import couvreChefs from '~/assets/images/personnalisation/couvre-chefs.jpg';

const lang = 'fr' as const;
const t = useTranslations(lang);
const title = 'Personnalisation de vos EPI et vêtements professionnels';
const description =
	"Affirmez l'identité de votre entreprise : broderie, transfert ou sérigraphie sur vos EPI et vêtements de travail, dans le respect des normes de sécurité en vigueur.";

const techniques = [
	{
		name: 'Broderie',
		image: broderieImage,
		body: "La solution la plus durable et la plus valorisante : le logo est brodé au fil dans le textile. Idéale pour les polos, sweats, vestes, bonnets et casquettes portés au quotidien, elle résiste aux lavages répétés et conserve un rendu haut de gamme dans le temps.",
	},
	{
		name: 'Transfert',
		image: transfertImage,
		body: "Un marquage net et précis, adapté aux petites et moyennes séries comme aux logos détaillés ou multicolores. Le transfert convient particulièrement aux vêtements haute visibilité, car il préserve les surfaces réfléchissantes et la conformité de l'équipement.",
	},
	{
		name: 'Sérigraphie',
		image: serigraphieImage,
		body: "La technique de référence pour les grandes séries et les grands formats : couleurs vives, excellent rapport qualité-prix et rendu homogène sur l'ensemble de la dotation. Parfaite pour les t-shirts, gilets et vestes marqués au dos.",
	},
];

const steps = [
	{ title: 'Choix des équipements', body: 'Sélectionnez vos EPI et vêtements de travail dans notre catalogue.' },
	{ title: 'Transmission du logo', body: 'Envoyez-nous votre logo ou votre charte graphique.' },
	{
		title: 'Conseils techniques',
		body: 'Nous recommandons la technique et les emplacements adaptés au support, au volume et aux conditions d’usage.',
	},
	{ title: 'Validation du marquage', body: 'Vous validez une maquette précise avant tout lancement en production.' },
	{ title: 'Production et livraison', body: 'Nous produisons et livrons vos équipements personnalisés.' },
];

const benefits = [
	'Valoriser l’image de votre entreprise avec une cohérence visuelle sur toute la dotation',
	'Identifier clairement vos équipes sur site et auprès du public',
	'Renforcer le sérieux et le professionnalisme perçus par vos clients',
	'Développer la visibilité de votre marque au quotidien',
];
---

<Layout title={`${title} — ${ui.fr['site.title']}`} description={description}>
	<main class="mx-auto max-w-6xl px-4 py-10">
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: '/' }, { label: 'Personnalisation' }]} />
		<h1 class="mb-6 font-heading text-3xl font-bold uppercase text-gray-900">Personnalisation</h1>

		<div class="grid items-center gap-8 lg:grid-cols-2">
			<div class="space-y-4 text-gray-700">
				<p class="text-lg font-medium text-gray-900">{title}</p>
				<p>
					La personnalisation de vos équipements affirme l'identité de votre entreprise et renforce la visibilité de
					votre marque, sur le chantier comme à l'atelier. Marquage haute résistance adapté aux environnements
					exigeants, plusieurs techniques selon vos volumes et vos supports, et un accompagnement complet de la
					conception à la livraison.
				</p>
				<p>
					Toute personnalisation est réalisée dans le respect des normes de sécurité applicables aux équipements de
					protection individuelle (Règlement (UE) 2016/425) : sur les vêtements haute visibilité, les surfaces
					réfléchissantes obligatoires sont préservées.
				</p>
			</div>
			<Image src={equipeChantier} alt="Équipe de chantier portant des EPI personnalisés au logo de l'entreprise" width={1200} height={800} class="rounded-lg" />
		</div>

		<h2 class="mb-4 mt-12 font-heading text-2xl font-bold uppercase text-gray-900">Quels équipements personnaliser ?</h2>
		<div class="grid gap-4 sm:grid-cols-3">
			<figure class="overflow-hidden rounded-lg border border-gray-200">
				<Image src={poloBroderie} alt="Polo noir brodé d'un logo d'entreprise sur la poitrine" width={600} height={600} class="h-48 w-full object-cover" />
				<figcaption class="p-4 text-sm text-gray-700">
					<strong class="text-gray-900">Vêtements de travail</strong> — t-shirts, polos, sweats, vestes, pantalons et
					doudounes de nos gammes.
				</figcaption>
			</figure>
			<figure class="overflow-hidden rounded-lg border border-gray-200">
				<Image src={vesteHvDos} alt="Veste haute visibilité marquée d'un grand logo dans le dos" width={600} height={600} class="h-48 w-full object-cover object-top" />
				<figcaption class="p-4 text-sm text-gray-700">
					<strong class="text-gray-900">Vêtements haute visibilité</strong> — marquage conforme, surfaces
					réfléchissantes préservées.
				</figcaption>
			</figure>
			<figure class="overflow-hidden rounded-lg border border-gray-200">
				<Image src={couvreChefs} alt="Bonnet, casque de chantier et casquette personnalisés au logo" width={600} height={600} class="h-48 w-full object-cover" />
				<figcaption class="p-4 text-sm text-gray-700">
					<strong class="text-gray-900">Casques, casquettes et bonnets</strong> — personnalisables selon la
					compatibilité de chaque équipement.
				</figcaption>
			</figure>
		</div>

		<h2 class="mb-4 mt-12 font-heading text-2xl font-bold uppercase text-gray-900">Nos techniques de marquage</h2>
		<div class="grid gap-4 sm:grid-cols-3">
			{
				techniques.map((technique) => (
					<article class="overflow-hidden rounded-lg border border-gray-200">
						<Image src={technique.image} alt={`${technique.name} sur vêtement professionnel`} width={600} height={400} class="h-44 w-full object-cover" />
						<div class="p-4">
							<h3 class="mb-2 font-heading text-lg font-bold text-gray-900">{technique.name}</h3>
							<p class="text-sm text-gray-700">{technique.body}</p>
						</div>
					</article>
				))
			}
		</div>
		<p class="mt-4 text-gray-700">
			Chaque technique s'adapte au support, au volume et aux contraintes d'utilisation pour garantir durabilité et
			conformité. Pour le détail des procédés,
			<a href="/guide-marquage" class="font-medium text-brand hover:text-brand-dark">consultez notre guide de marquage</a>.
		</p>

		<h2 class="mb-4 mt-12 font-heading text-2xl font-bold uppercase text-gray-900">Comment ça marche ?</h2>
		<ol class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
			{
				steps.map((step, index) => (
					<li class="rounded-lg border border-gray-200 p-4">
						<span class="mb-2 flex h-8 w-8 items-center justify-center rounded-full bg-brand font-heading font-bold text-white">
							{index + 1}
						</span>
						<h3 class="mb-1 font-semibold text-gray-900">{step.title}</h3>
						<p class="text-sm text-gray-700">{step.body}</p>
					</li>
				))
			}
		</ol>

		<h2 class="mb-4 mt-12 font-heading text-2xl font-bold uppercase text-gray-900">
			Pourquoi personnaliser vos équipements ?
		</h2>
		<ul class="grid gap-3 sm:grid-cols-2">
			{
				benefits.map((benefit) => (
					<li class="flex gap-3 text-gray-700">
						<svg class="mt-1 h-4 w-4 shrink-0 text-brand" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path
								fill-rule="evenodd"
								d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
								clip-rule="evenodd"
							/>
						</svg>
						{benefit}
					</li>
				))
			}
		</ul>

		<div class="mt-12 rounded-lg bg-gray-50 p-8 text-center">
			<p class="mb-4 font-heading text-xl font-bold text-gray-900">Un projet de personnalisation ?</p>
			<p class="mb-6 text-gray-700">Réponse sous 24h — sans engagement.</p>
			<Button href="/devis" variant="primary">Demander mon devis</Button>
		</div>
	</main>
</Layout>
