---
import Layout from '~/layouts/Layout.astro';
import PersonnalisationPage from '~/components/content/PersonnalisationPage.astro';
import { customisationCopy } from '~/data/customisation-copy';
import { ui } from '~/i18n/ui';

const lang = 'fr' as const;
---

<Layout title={`${customisationCopy.metaTitle[lang]} — ${ui.fr['site.title']}`} description={customisationCopy.metaDescription[lang]}>
	<PersonnalisationPage lang={lang} />
</Layout>
