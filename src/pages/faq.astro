---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';

const lang = 'fr' as const;
const t = useTranslations(lang);
const title = t('footer.legal.faq');
const description =
	"Questions fréquentes sur les commandes, devis, marquage, conformité et livraisons d'équipements de protection individuelle Protex EPI.";

const faqs = [
	{
		question: 'Pourquoi mon panier contient-il des frais de manutention pour les achats sous la limite ?',
		answer:
			'Nous ne traitons pas de production ni de conditionnement à la pièce et les coûts associés au traitement de quantités inférieures à la limite dépassent le prix de vente des équipements. Pour un très petit nombre de pièces, une commission dite de sous-limite est donc automatiquement ajoutée au panier.',
	},
	{
		question: 'Pourquoi ne puis-je pas acheter seulement 1 pièce du produit sélectionné ?',
		answer:
			'Vous pouvez commander un article seul, sans marquage, mais la commande devra être accompagnée de frais de traitement. Si vous souhaitez uniquement tester un modèle avant de passer commande en quantité (confort, taille, conformité au poste de travail), contactez notre service commercial : nous nous ferons un plaisir de vous prêter ou vous faire parvenir un échantillon pour la durée convenue.',
	},
	{
		question: 'Pourquoi indiquez-vous un prix pour 1 pièce alors que je ne peux pas en acheter seulement 1 ?',
		answer:
			'Un article peut être ajouté à une commande combinée contenant déjà d’autres équipements. Par exemple, vous pouvez constituer une commande de vêtements de travail avec un ou plusieurs coloris et tailles différents pour équiper toute une équipe. Il reste également possible de commander un seul article, mais avec des frais de traitement.',
	},
	{
		question: 'Comment connaître le prix du marquage (logo, floquage) pour plusieurs tailles ou coloris ?',
		answer:
			'Vous pouvez renseigner différentes tailles, coloris et emplacements de marquage dans notre outil de calcul en ligne pour obtenir le prix final du marquage sur un mélange diversifié d’EPI et de vêtements de travail.',
	},
	{
		question: 'Puis-je acheter en tant que particulier, c’est-à-dire sans numéro de TVA ou SIRET ?',
		answer:
			'Non, la vente d’équipements de protection individuelle sur la e-boutique www.protex-epi.com est réservée aux professionnels : entreprises, collectivités, établissements publics et associations.',
	},
	{
		question: 'Comment savoir si un EPI est conforme aux normes en vigueur pour mon secteur d’activité ?',
		answer:
			'Chaque fiche produit précise la catégorie de risque et les normes européennes applicables (EN, Règlement (UE) 2016/425). En cas de doute sur l’adéquation d’un équipement à votre analyse de risques ou à votre document unique, notre équipe technique peut vous conseiller sur le choix du produit.',
	},
	{
		question: 'Puis-je obtenir un certificat de conformité (déclaration UE de conformité, fiche technique) pour mes achats ?',
		answer:
			'Oui. Les fiches techniques et déclarations de conformité sont disponibles sur chaque fiche produit ou peuvent vous être transmises sur simple demande à notre service commercial, notamment dans le cadre d’un contrôle interne ou d’une réponse à un marché public.',
	},
	{
		question: 'Vendez-vous dans le cadre des marchés publics ?',
		answer:
			'Oui, nous accompagnons les acheteurs publics (collectivités, établissements publics, administrations) dans leurs achats d’EPI, y compris pour l’émission de devis, bons de commande et pièces justificatives nécessaires à vos procédures d’achat.',
	},
	{
		question: 'Puis-je retourner un EPI qui ne convient pas ?',
		answer:
			'Pour des raisons d’hygiène et de sécurité, les EPI personnalisés, portés ou déconditionnés ne peuvent pas faire l’objet d’un retour. Un produit non porté et dans son emballage d’origine peut être retourné après accord préalable écrit de notre service commercial.',
	},
	{
		question: 'Quels sont les délais de livraison ?',
		answer:
			'Les délais varient selon les produits et les quantités commandées, de quelques jours pour les articles en stock à plusieurs semaines pour les commandes personnalisées ou fabriquées sur mesure. Un délai précis vous est communiqué lors de la confirmation de votre devis ou commande.',
	},
];

const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((faq) => ({
		'@type': 'Question',
		name: faq.question,
		acceptedAnswer: { '@type': 'Answer', text: faq.answer },
	})),
};
---

<Layout title={`${title} — ${ui.fr['site.title']}`} description={description} jsonLd={faqJsonLd}>
	<main class="mx-auto max-w-3xl px-4 py-10">
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: '/' }, { label: title }]} />
		<h1 class="mb-6 text-2xl font-semibold text-gray-900">FAQ – PROTEX EPI</h1>
		<div class="space-y-6">
			{
				faqs.map((faq) => (
					<section>
						<h2 class="mb-1 font-semibold text-gray-900">{faq.question}</h2>
						<p class="text-gray-700">{faq.answer}</p>
					</section>
				))
			}
		</div>
	</main>
</Layout>
