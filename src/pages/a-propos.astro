---
import Layout from '~/layouts/Layout.astro';
import AboutPage from '~/components/content/AboutPage.astro';
import { aboutCopy } from '~/data/about-copy';
import { ui } from '~/i18n/ui';

const lang = 'fr' as const;
---

<Layout title={`${aboutCopy.metaTitle[lang]} — ${ui.fr['site.title']}`} description={aboutCopy.metaDescription[lang]}>
	<AboutPage lang={lang} />
</Layout>
