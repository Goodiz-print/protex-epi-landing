---
import Layout from '~/layouts/Layout.astro';
import Breadcrumb from '~/components/catalog/Breadcrumb.astro';
import { useTranslations } from '~/i18n/utils';
import { ui } from '~/i18n/ui';

const lang = 'fr' as const;
const t = useTranslations(lang);
const title = t('footer.legal.contact');
const description = 'Contactez Protex EPI : adresse, téléphone, e-mail, ou envoyez directement une demande de devis.';
const mapsHref = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('4 Rue la Motte Picquet, 33300 Bordeaux, France');
---

<Layout title={`${title} — ${ui.fr['site.title']}`} description={description}>
	<main class="mx-auto max-w-2xl px-4 py-10">
		<Breadcrumb items={[{ label: t('catalog.breadcrumb.home'), href: '/' }, { label: title }]} />
		<h1 class="mb-6 text-2xl font-semibold text-gray-900">{title}</h1>
		<ul class="space-y-3 text-gray-700">
			<li>
				<span class="font-medium text-gray-900">Adresse : </span>
				<a href={mapsHref} target="_blank" rel="noopener noreferrer" class="text-blue-700 hover:text-blue-800">
					{t('footer.contact.addressLine')}
				</a>
			</li>
			<li>
				<span class="font-medium text-gray-900">Téléphone : </span>
				<a href="tel:0557027587" class="text-blue-700 hover:text-blue-800">05 57 02 75 87</a>
			</li>
			<li>
				<span class="font-medium text-gray-900">E-mail : </span>
				<a href="mailto:contact@protex-epi.com" class="text-blue-700 hover:text-blue-800">contact@protex-epi.com</a>
			</li>
		</ul>
		<p class="mt-8 text-gray-700">
			Pour une demande précise (produits, quantités, délais), utilisez plutôt notre
			<a href="/devis" class="font-medium text-blue-700 hover:text-blue-800">formulaire de demande de devis</a>.
		</p>
	</main>
</Layout>
