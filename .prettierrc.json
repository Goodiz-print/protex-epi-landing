{
	"useTabs": true,
	"singleQuote": true,
	"semi": true,
	"trailingComma": "all",
	"printWidth": 120,
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"parser": "astro"
			}
		},
		{
			"files": ["package.json", "*.yml", "*.yaml", "*.md"],
			"options": {
				"useTabs": false
			}
		}
	]
}
