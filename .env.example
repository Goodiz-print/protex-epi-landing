# Quote-request form (src/components/QuoteForm.astro).
# Set this to a form-to-email service endpoint to activate real submissions
# (e.g. a Formspree form URL: https://formspree.io/f/xxxxxxx).
# Left unset, the form shows a "contact us directly" fallback instead of
# submitting nowhere.
PUBLIC_QUOTE_FORM_ENDPOINT=

# Consent-gated analytics (src/components/CookieConsent.astro). See Phase 8.
# Plausible: set to your site domain, e.g. protex-epi.com
PUBLIC_PLAUSIBLE_DOMAIN=
