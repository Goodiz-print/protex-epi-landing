# Quote-request form (src/components/QuoteForm.astro).
# By default the form opens the visitor's own email client via a pre-filled
# mailto: link to contact@protex-epi.com — no account or backend needed.
# Optionally set this to a form-to-email service endpoint (e.g. a Formspree
# form URL: https://formspree.io/f/xxxxxxx) to submit silently instead; the
# mailto: fallback still kicks in if that request ever fails.
PUBLIC_QUOTE_FORM_ENDPOINT=

# Consent-gated analytics (src/components/CookieConsent.astro). See Phase 8.
# Plausible: set to your site domain, e.g. protex-epi.com
PUBLIC_PLAUSIBLE_DOMAIN=
